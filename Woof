--==============================================================
-- REMOTE VALIDATION
--==============================================================

function COS:GetAIRemote()

    local Remote =
        ReplicatedStorage:FindFirstChild(
            self.AI.RemoteName
        )

    if not Remote then
        return nil, "RemoteFunction não encontrado."
    end

    if not Remote:IsA("RemoteFunction") then
        return nil, "O objeto encontrado não é RemoteFunction."
    end

    return Remote
end

--==============================================================
-- REQUEST VALIDATION
--==============================================================

function COS:ValidateAIRequest(Message)

    if not self.Config.General.Enabled then
        return false, "COS desativado."
    end

    if not self.Config.AI.BaseURL:match("^https://") then
        return false, "Endereço HTTPS não configurado."
    end

    if typeof(Message) ~= "string" then
        return false, "Mensagem inválida."
    end

    Message = self:Trim(Message)

    if Message == "" then
        return false, "Mensagem vazia."
    end

    if #Message > self.AI.MaximumPromptLength then
        return false, "Mensagem muito longa."
    end

    if self.State.IsResponding then
        return false, "O COS já está respondendo."
    end

    return true
end

--==============================================================
-- REQUEST BUILDER
--==============================================================

function COS:BuildAIRequest(Message, Context)

    local SafeContext = ""

    if typeof(Context) == "string" then

        SafeContext = string.sub(
            Context,
            1,
            self.AI.MaximumContextLength
        )

    end

    return {

        RequestId = HttpService:GenerateGUID(false),

        Message = Message,

        Context = SafeContext,

        Model = self.Config.AI.Model,

        Parameters = {

            MaxTokens = self.Config.AI.MaxTokens,

            Temperature = self.Config.AI.Temperature,

        },

        Language = self.Config.General.Language,

    }

end

--==============================================================
-- RESPONSE VALIDATION
--==============================================================

function COS:ValidateAIResponse(Response)

    if typeof(Response) ~= "table" then
        return false, "Resposta inválida do servidor."
    end

    if Response.success ~= true then

        return false,
            tostring(Response.error or "Falha desconhecida.")

    end

    if typeof(Response.text) ~= "string" then
        return false, "O servidor não retornou texto."
    end

    local Text = self:Trim(Response.text)

    if Text == "" then
        return false, "A resposta da IA está vazia."
    end

    return true, Text
end

--==============================================================
-- MAIN AI REQUEST
--==============================================================

function COS:RequestAI(Message, Context)

    local Valid, ValidationError =
        self:ValidateAIRequest(Message)

    if not Valid then

        self:Log(
            "AI",
            "Solicitação recusada: " .. ValidationError
        )

        return nil, ValidationError
    end

    local Remote, RemoteError = self:GetAIRemote()

    if not Remote then

        self:AIError(
            "CONNECTION",
            RemoteError
        )

        return nil, self:AIErrorMessage()
    end

    local Payload = self:BuildAIRequest(
        self:Trim(Message),
        Context
    )

    self.State.IsResponding = true

    self.State.LastQuestion = Message

    self:Log(
        "AI",
        "Enviando solicitação ao serviço autorizado."
    )

    --==========================================================
    -- ASYNC REQUEST
    --==========================================================

    local Finished = false
    local Success = false
    local Result = nil

    task.spawn(function()

        Success, Result = pcall(function()

            return Remote:InvokeServer(Payload)

        end)

        Finished = true

    end)

    --==========================================================
    -- TIMEOUT CONTROL
    --==========================================================

    local StartTime = self:Now()
    local Timeout = self.Config.AI.Timeout

    while not Finished do

        if self:Now() - StartTime >= Timeout then
            break
        end

        task.wait(0.05)

    end

    self.State.IsResponding = false

    if not Finished then

        self:AIError(
            "TIMEOUT",
            "O servidor não respondeu dentro do prazo."
        )

        return nil, self:AIErrorMessage()
    end

    if not Success then

        self:AIError(
            "CONNECTION",
            tostring(Result)
        )

        return nil, self:AIErrorMessage()
    end

    --==========================================================
    -- VALIDATE RESULT
    --==========================================================

    local ResponseValid, ResponseText =
        self:ValidateAIResponse(Result)

    if not ResponseValid then

        self:AIError(
            "SERVER",
            ResponseText
        )

        return nil, self:AIErrorMessage()
    end

    --==========================================================
    -- SUCCESS
    --==========================================================

    self.State.Connected = true
    self.State.APIAvailable = true

    self.State.LastResponse = ResponseText

    self.State.QuestionsAnswered += 1

    local Latency = self:Now() - StartTime

    self:Log(
        "AI",
        "Resposta recebida em " ..
        self:FormatTime(Latency) .. " segundos."
    )

    if self.UI and self.UI.AI then

        self.UI.AI.UpdateStatus()

    end

    return ResponseText

end

