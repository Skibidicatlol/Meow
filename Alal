--========================================================--
-- OCULTAÇÃO DO PERSONAGEM ORIGINAL
--========================================================--

S.EnforceLocalObjectHidden = function(object)
    if not object then return end

    if object:IsA("BasePart") then
        object.Transparency = 1
        object.LocalTransparencyModifier = 1
        object.CastShadow = false

    elseif object:IsA("Decal")
        or object:IsA("Texture") then

        object.Transparency = 1

    elseif object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Beam")
        or object:IsA("Fire")
        or object:IsA("Smoke")
        or object:IsA("Sparkles")
        or object:IsA("BillboardGui")
        or object:IsA("SurfaceGui")
        or object:IsA("Highlight") then

        object.Enabled = false
    end
end

--========================================================--
-- CAPTURAR PROPRIEDADES ORIGINAIS
--========================================================--

S.CaptureLocalTransparency = function(object)
    if not object then return end

    if object:IsA("BasePart") then

        if object:GetAttribute("R6OriginalTransparency") == nil then
            object:SetAttribute(
                "R6OriginalTransparency",
                object.Transparency
            )
        end

        if object:GetAttribute("R6OriginalLocalTransparencyModifier") == nil then
            object:SetAttribute(
                "R6OriginalLocalTransparencyModifier",
                object.LocalTransparencyModifier
            )
        end

        if object:GetAttribute("R6OriginalCastShadow") == nil then
            object:SetAttribute(
                "R6OriginalCastShadow",
                object.CastShadow
            )
        end

    elseif object:IsA("Decal")
        or object:IsA("Texture") then

        if object:GetAttribute("R6OriginalTransparency") == nil then
            object:SetAttribute(
                "R6OriginalTransparency",
                object.Transparency
            )
        end

    elseif object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Beam")
        or object:IsA("Fire")
        or object:IsA("Smoke")
        or object:IsA("Sparkles")
        or object:IsA("BillboardGui")
        or object:IsA("SurfaceGui")
        or object:IsA("Highlight") then

        if object:GetAttribute("R6OriginalEnabled") == nil then
            object:SetAttribute(
                "R6OriginalEnabled",
                object.Enabled
            )
        end
    end
end

--========================================================--
-- MONITORAMENTO DOS OBJETOS ORIGINAIS
--========================================================--

S.MonitorLocalObject = function(state, object)
    if not state or not object then return end

    state.MonitoredObjects = state.MonitoredObjects or {}

    if state.MonitoredObjects[object] then
        return
    end

    state.MonitoredObjects[object] = true

    S.CaptureLocalTransparency(object)
    S.EnforceLocalObjectHidden(object)
end

--========================================================--
-- OCULTAR PERSONAGEM ORIGINAL
--========================================================--

S.HideLocalOriginal = function(state)
    if not state or not state.Source then return end

    state.MonitoredObjects = {}

    for _, object in ipairs(state.Source:GetDescendants()) do
        S.MonitorLocalObject(state, object)
    end

    S.Connect(
        state.Connections,

        state.Source.DescendantAdded:Connect(function(object)
            if state.Active then
                S.MonitorLocalObject(state, object)
            end
        end)
    )
end

--========================================================--
-- GARANTIR QUE O ORIGINAL CONTINUE OCULTO
--========================================================--

S.EnforceLocalOriginalHidden = function(state)
    if not state or not state.Source then return end

    for object in pairs(state.MonitoredObjects or {}) do
        if object and object.Parent then
            S.EnforceLocalObjectHidden(object)
        end
    end
end

--========================================================--
-- RESTAURAR PERSONAGEM ORIGINAL
--========================================================--

S.RestoreLocalOriginal = function(state)
    if not state then return end

    for object in pairs(state.MonitoredObjects or {}) do
        if object and object.Parent then

            if object:IsA("BasePart") then

                local transparency =
                    object:GetAttribute("R6OriginalTransparency")

                local localTransparency =
                    object:GetAttribute(
                        "R6OriginalLocalTransparencyModifier"
                    )

                local shadow =
                    object:GetAttribute("R6OriginalCastShadow")

                if transparency ~= nil then
                    object.Transparency = transparency
                end

                if localTransparency ~= nil then
                    object.LocalTransparencyModifier = localTransparency
                end

                if shadow ~= nil then
                    object.CastShadow = shadow
                end

            elseif object:IsA("Decal")
                or object:IsA("Texture") then

                local transparency =
                    object:GetAttribute("R6OriginalTransparency")

                if transparency ~= nil then
                    object.Transparency = transparency
                end

            elseif object:IsA("ParticleEmitter")
                or object:IsA("Trail")
                or object:IsA("Beam")
                or object:IsA("Fire")
                or object:IsA("Smoke")
                or object:IsA("Sparkles")
                or object:IsA("BillboardGui")
                or object:IsA("SurfaceGui")
                or object:IsA("Highlight") then

                local enabled =
                    object:GetAttribute("R6OriginalEnabled")

                if enabled ~= nil then
                    object.Enabled = enabled
                end
            end
        end
    end

    state.MonitoredObjects = {}
end

--========================================================--
-- ATUALIZAR TAMANHOS DO R6 LOCAL
--========================================================--

S.UpdateLocalSizes = function(state)
    if not state or not state.Active then return end

    S.UpdatePartSizes(state)
    S.UpdateAccessories(state)

    S.EnforceLocalOriginalHidden(state)
end

--========================================================--
-- MONITORAR ALTERAÇÕES DE TAMANHO
--========================================================--

S.MonitorLocalSizeObject = function(state, object)
    if not state
        or not state.Active
        or not object then
        return
    end

    state.SizeMonitored = state.SizeMonitored or {}

    if state.SizeMonitored[object] then
        return
    end

    -- Monitorar tamanho físico das peças.
    if object:IsA("BasePart") then

        state.SizeMonitored[object] = true

        S.Connect(
            state.Connections,

            object:GetPropertyChangedSignal("Size"):Connect(function()
                if state.Active then
                    S.UpdateLocalSizes(state)
                end
            end)
        )

    -- Monitorar escala visual de SpecialMesh.
    elseif object:IsA("SpecialMesh") then

        state.SizeMonitored[object] = true

        S.Connect(
            state.Connections,

            object:GetPropertyChangedSignal("Scale"):Connect(function()
                if state.Active then
                    S.UpdateLocalSizes(state)
                end
            end)
        )
    end
end

--========================================================--
-- MONITORAR TODAS AS PEÇAS E MESHES
--========================================================--

S.MonitorLocalSizeChanges = function(state)
    if not state or not state.Source then return end

    state.SizeMonitored = state.SizeMonitored or {}

    -- Monitorar objetos que já existem.
    for _, object in ipairs(state.Source:GetDescendants()) do

        if object:IsA("BasePart")
            or object:IsA("SpecialMesh") then

            S.MonitorLocalSizeObject(state, object)
        end
    end

    -- Monitorar peças e meshes adicionados posteriormente.
    S.Connect(
        state.Connections,

        state.Source.DescendantAdded:Connect(function(object)
            if not state.Active then return end

            if object:IsA("BasePart")
                or object:IsA("SpecialMesh") then

                S.MonitorLocalSizeObject(state, object)

                -- Atualiza imediatamente após a adição.
                S.UpdateLocalSizes(state)
            end
        end)
    )
end

--========================================================--
-- ANIMAÇÕES CLASSIC
--========================================================--

S.StopClassicAnimations = function()
    for name, track in pairs(S.AnimationTracks or {}) do
        if track then
            pcall(function()
                track:Stop(0.15)
                track:Destroy()
            end)
        end

        S.AnimationTracks[name] = nil
    end

    S.AnimationController = nil
    S.CurrentAnimation = nil
end

--========================================================--
-- CARREGAR ANIMAÇÕES
--========================================================--

S.LoadClassicAnimations = function(humanoid)
    S.StopClassicAnimations()

    if not humanoid then return false end

    local animator = humanoid:FindFirstChildOfClass("Animator")

    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    S.AnimationController = animator

    for name, animationId in pairs(S.CONFIG.ANIMATIONS) do

        local animation = Instance.new("Animation")
        animation.Name = "R6_" .. name
        animation.AnimationId = animationId

        local success, track = pcall(function()
            return animator:LoadAnimation(animation)
        end)

        animation:Destroy()

        if success and track then

            if name == "Idle" then
                track.Priority = Enum.AnimationPriority.Idle

            elseif name == "Walk"
                or name == "Run" then

                track.Priority = Enum.AnimationPriority.Movement

            else
                track.Priority = Enum.AnimationPriority.Action
            end

            track.Looped = (
                name == "Idle"
                or name == "Walk"
                or name == "Run"
                or name == "Climb"
            )

            S.AnimationTracks[name] = track
        end
    end

    return true
end

--========================================================--
-- PARAR ANIMAÇÃO ATUAL
--========================================================--

S.StopCurrentClassicAnimation = function()
    if not S.CurrentAnimation then return end

    local track = S.AnimationTracks[S.CurrentAnimation]

    if track then
        pcall(function()
            track:Stop(0.15)
        end)
    end

    S.CurrentAnimation = nil
end

--========================================================--
-- TOCAR ANIMAÇÃO
--========================================================--

S.PlayClassicAnimation = function(name, speed)
    if not name then return end

    local track = S.AnimationTracks[name]

    if not track then return end

    if S.CurrentAnimation == name and track.IsPlaying then
        if speed then
            pcall(function()
                track:AdjustSpeed(speed)
            end)
        end

        return
    end

    S.StopCurrentClassicAnimation()

    S.CurrentAnimation = name

    pcall(function()
        track:Play(0.15)

        if speed then
            track:AdjustSpeed(speed)
        end
    end)
end

--========================================================--
-- ATUALIZAR ANIMAÇÃO CLASSIC
--========================================================--

S.UpdateClassicAnimation = function()
    local state = S.LocalState

    if not state
        or not state.Active
        or state.Mode ~= "Classic" then
        return
    end

    local sourceHumanoid = state.SourceHumanoid
    local rigHumanoid = state.RigHumanoid

    if not sourceHumanoid or not rigHumanoid then
        return
    end

    if sourceHumanoid.Health <= 0 then
        S.PlayClassicAnimation("Idle")
        return
    end

    local sourceRoot = state.SourceRoot

    if not sourceRoot or not sourceRoot.Parent then
        return
    end

    local velocity = sourceRoot.AssemblyLinearVelocity

    local horizontalSpeed = Vector3.new(
        velocity.X,
        0,
        velocity.Z
    ).Magnitude

    local stateType = sourceHumanoid:GetState()

    local animationName = "Idle"
    local animationSpeed = 1

    if stateType == Enum.HumanoidStateType.Jumping then

        animationName = "Jump"

    elseif stateType == Enum.HumanoidStateType.Freefall then

        animationName = "Fall"

    elseif stateType == Enum.HumanoidStateType.Climbing then

        animationName = "Climb"

    elseif horizontalSpeed > 0.5 then

        animationName = "Walk"

        animationSpeed = math.max(
            S.CONFIG.MIN_ANIMATION_SPEED,

            horizontalSpeed /
            math.max(S.CONFIG.REFERENCE_SPEED, 0.001)
        )

        animationSpeed *=
            S.CONFIG.ANIMATION_SPEED_MULTIPLIER
    end

    S.PlayClassicAnimation(
        animationName,
        animationSpeed
    )
end

