-- DEBUG UI
--==============================================================

COS.UI.Section(
    "Debug",
    "INFORMAÇÕES DO SISTEMA"
)

local DebugStatus = COS.UI.Info(
    "Debug",
    "Aguardando..."
)

local function UpdateDebug()

    DebugStatus.Text = string.format(
        "Versão: %s\nIA: %s\nPercepção: %s\nDecisões: %s",
        COS.Version,

        COS.State.APIAvailable
            and "Disponível"
            or "Desconectada",

        COS.Perception.Running
            and "Ativa"
            or "Parada",

        COS.Decision.Running
            and "Ativo"
            or "Parado"
    )

end

--==============================================================
-- MAIN UPDATE LOOP
--==============================================================

COS.State.Running = true

COS:AddConnection(
    RunService.Heartbeat:Connect(function()

        if not COS.State.Running then
            return
        end

        COS:UpdateCooldown()

    end)
)

task.spawn(function()

    while COS.State.Running do

        COS:UpdateMainStatus()
        UpdateDebug()

        for _, UpdateFunction in pairs(
            UpdateStatistics
        ) do

            UpdateFunction()

        end

        task.wait(1)

    end

end)

--==============================================================
-- SHUTDOWN
--==============================================================

function COS:Shutdown()

    if not self.State.Running then
        return
    end

    self.State.Running = false

    self:StopPerception()
    self:StopDecisionLoop()
    self:StopMovement()

    self:DisconnectAll()

    if self.UI and self.UI.ScreenGui then
        self.UI.ScreenGui:Destroy()
    end

    self.State.Connected = false
    self.State.APIAvailable = false

    self:Log(
        "SYSTEM",
        "COS encerrado."
    )

end

--==============================================================
-- FINAL INITIALIZATION
--==============================================================

COS:UpdateCharacter()

if COS.Config.Perception.Enabled then
    COS:StartPerception()
end

if COS.Config.General.AutonomousMode then
    COS:StartDecisionLoop()
end

COS.Finalized = true

COS:Log(
    "SYSTEM",
    "COS inicializado."
)

print("================================")
print(" COS — CHATGPTOSS")
print(" Versão:", COS.Version)
print(" Todas as 8 partes carregadas.")
print(" Sistemas integrados.")
print("================================")

