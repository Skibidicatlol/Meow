local S = ((getgenv and getgenv()) or _G).R6System
assert(S, "Execute a Parte A antes da Parte C.")

--========================================================--
-- GARANTIR ESTRUTURAS
--========================================================--

S.AnimationTracks = S.AnimationTracks or {}
S.CurrentAnimation = nil

--========================================================--
-- OCULTAR OBJETOS ORIGINAIS DO JOGADOR
--========================================================--

S.EnforceLocalObjectHidden = function(object)
    if not object or not object.Parent then
        return
    end

    if object:IsA("BasePart") then
        object.Transparency = 1
        object.LocalTransparencyModifier = 1
        object.CastShadow = false

    elseif object:IsA("Decal") or object:IsA("Texture") then
        object.Transparency = 1

    elseif object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Beam")
        or object:IsA("BillboardGui")
        or object:IsA("SurfaceGui")
        or object:IsA("Highlight") then

        object.Enabled = false
    end
end

--========================================================--
-- CAPTURAR TRANSPARÊNCIA ORIGINAL
--========================================================--

S.CaptureLocalTransparency = function(object)
    if not object then
        return
    end

    if object:GetAttribute("R6OriginalTransparency") == nil then
        if object:IsA("BasePart")
            or object:IsA("Decal")
            or object:IsA("Texture") then

            object:SetAttribute(
                "R6OriginalTransparency",
                object.Transparency
            )
        end
    end

    if object:IsA("BasePart") then
        if object:GetAttribute("R6OriginalCastShadow") == nil then
            object:SetAttribute(
                "R6OriginalCastShadow",
                object.CastShadow
            )
        end
    end
end

--========================================================--
-- MONITORAR OBJETOS ORIGINAIS
--========================================================--

S.MonitorLocalObject = function(state, object)
    if not state or state.Destroyed or not object then
        return
    end

    S.CaptureLocalTransparency(object)
    S.EnforceLocalObjectHidden(object)

    local function ConnectProperty(property)
        local connection = object:GetPropertyChangedSignal(property):Connect(function()
            if not state.Destroyed then
                S.EnforceLocalObjectHidden(object)
            end
        end)

        table.insert(state.Connections, connection)
    end

    if object:IsA("BasePart") then
        ConnectProperty("Transparency")
        ConnectProperty("LocalTransparencyModifier")
        ConnectProperty("CastShadow")

    elseif object:IsA("Decal") or object:IsA("Texture") then
        ConnectProperty("Transparency")

    elseif object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Beam")
        or object:IsA("BillboardGui")
        or object:IsA("SurfaceGui")
        or object:IsA("Highlight") then

        ConnectProperty("Enabled")
    end
end

--========================================================--
-- OCULTAR PERSONAGEM ORIGINAL
--========================================================--

S.HideLocalOriginal = function(state)
    if not state or not state.Original then
        return
    end

    for _, object in ipairs(state.Original:GetDescendants()) do
        S.MonitorLocalObject(state, object)
    end

    -- Monitorar objetos adicionados posteriormente.
    if not state.DescendantAddedConnection then
        state.DescendantAddedConnection =
            state.Original.DescendantAdded:Connect(function(object)
                if not state.Destroyed then
                    S.MonitorLocalObject(state, object)
                end
            end)

        table.insert(
            state.Connections,
            state.DescendantAddedConnection
        )
    end
end

S.EnforceLocalOriginalHidden = function(state)
    if not state or state.Destroyed or not state.Original then
        return
    end

    for _, object in ipairs(state.Original:GetDescendants()) do
        S.EnforceLocalObjectHidden(object)
    end
end

--========================================================--
-- RESTAURAR PERSONAGEM ORIGINAL
--========================================================--

S.RestoreLocalOriginal = function(state)
    if not state or not state.Original then
        return
    end

    for _, object in ipairs(state.Original:GetDescendants()) do
        if object:IsA("BasePart") then
            local transparency =
                object:GetAttribute("R6OriginalTransparency")

            local castShadow =
                object:GetAttribute("R6OriginalCastShadow")

            object.LocalTransparencyModifier = 0
            object.Transparency = transparency ~= nil and transparency or 0
            object.CastShadow = castShadow ~= nil and castShadow or true

        elseif object:IsA("Decal") or object:IsA("Texture") then
            local transparency =
                object:GetAttribute("R6OriginalTransparency")

            object.Transparency =
                transparency ~= nil and transparency or 0

        elseif object:IsA("ParticleEmitter")
            or object:IsA("Trail")
            or object:IsA("Beam")
            or object:IsA("BillboardGui")
            or object:IsA("SurfaceGui")
            or object:IsA("Highlight") then

            object.Enabled = true
        end
    end
end

--========================================================--
-- ATUALIZAÇÃO DE TAMANHO
--========================================================--

S.UpdateLocalSizes = function()
    local state = S.LocalState

    if not state
        or state.Destroyed
        or not state.Active
        or not state.Rig
        or not state.Original then

        return
    end

    if S.UpdatePartSizes then
        S.UpdatePartSizes(state)
    end

    if S.UpdateAccessories then
        S.UpdateAccessories(state)
    end

    S.EnforceLocalOriginalHidden(state)
end

S.MonitorLocalSizeChanges = function(state)
    if not state or not state.Original then
        return
    end

    for _, object in ipairs(state.Original:GetDescendants()) do
        if object:IsA("BasePart") then
            local connection =
                object:GetPropertyChangedSignal("Size"):Connect(function()

                    if not state.Destroyed and S.LocalState == state then
                        S.UpdateLocalSizes()
                    end
                end)

            table.insert(state.Connections, connection)
        end
    end
end

--========================================================--
-- ANIMAÇÕES CLÁSSICAS
--========================================================--

S.StopClassicAnimations = function()
    S.AnimationTracks = S.AnimationTracks or {}

    for _, track in pairs(S.AnimationTracks) do
        pcall(function()
            track:Stop(0.15)
            track:Destroy()
        end)
    end

    table.clear(S.AnimationTracks)

    S.CurrentAnimation = nil
end

S.LoadClassicAnimations = function()
    S.StopClassicAnimations()

    local rig = S.LocalR6

    if not rig or not rig.Parent then
        return false
    end

    local humanoid = rig:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return false
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")

    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    S.AnimationController = animator

    local animations = {
        Idle = "rbxassetid://180435571",
        Walk = "rbxassetid://180426354",
        Run = "rbxassetid://180426354",
        Jump = "rbxassetid://125750702",
        Fall = "rbxassetid://180436148",
    }

    for name, animationId in pairs(animations) do
        local animation = Instance.new("Animation")
        animation.AnimationId = animationId

        local success, track = pcall(function()
            return animator:LoadAnimation(animation)
        end)

        animation:Destroy()

        if success and track then
            if name == "Idle" then
                track.Priority = Enum.AnimationPriority.Idle

            elseif name == "Jump" or name == "Fall" then
                track.Priority = Enum.AnimationPriority.Action

            else
                track.Priority = Enum.AnimationPriority.Movement
            end

            S.AnimationTracks[name] = track
        end
    end

    return next(S.AnimationTracks) ~= nil
end

S.PlayClassicAnimation = function(name, fadeTime)
    local track = S.AnimationTracks and S.AnimationTracks[name]

    if not track then
        return
    end

    if S.CurrentAnimation == name and track.IsPlaying then
        return
    end

    for otherName, otherTrack in pairs(S.AnimationTracks) do
        if otherName ~= name and otherTrack.IsPlaying then
            otherTrack:Stop(fadeTime or 0.15)
        end
    end

    S.CurrentAnimation = name

    if not track.IsPlaying then
        track:Play(fadeTime or 0.15)
    end
end

S.UpdateClassicAnimation = function()
    if S.CurrentMode ~= "Classic" then
        return
    end

    local humanoid = S.LocalHumanoid

    if not humanoid then
        return
    end

    local humanoidState = humanoid:GetState()
    local moving = humanoid.MoveDirection.Magnitude > 0.05

    if humanoidState == Enum.HumanoidStateType.Jumping then
        S.PlayClassicAnimation("Jump")

    elseif humanoidState == Enum.HumanoidStateType.Freefall then
        S.PlayClassicAnimation("Fall")

    elseif moving then
        if humanoid.WalkSpeed > 16 then
            S.PlayClassicAnimation("Run")
        else
            S.PlayClassicAnimation("Walk")
        end

    else
        S.PlayClassicAnimation("Idle")
    end
end

--========================================================--
-- PREPARAÇÃO DOS RIGS
--========================================================--

S.PrepareClassicRig = function(state)
    if not state or not state.Rig or not state.Original then
        return false
    end

    state.Source = state.Original
    state.Mode = "Classic"

    S.CaptureAccessories(state)

    -- O modo Classic preserva os Motor6D originais
    -- criados pela função CreateR6 da Parte A.
    -- Não executar BuildIndividualWelds aqui.

    if not state.Rig:FindFirstChild("HumanoidRootPart") then
        return false
    end

    state.Active = true

    S.UpdatePartSizes(state)
    S.UpdateAccessories(state)

    S.HideLocalOriginal(state)
    S.MonitorLocalSizeChanges(state)

    return true
end

S.PrepareAnimatedRig = function(state)
    if not state or not state.Rig or not state.Original then
        return false
    end

    state.Source = state.Original
    state.Mode = "Animated"

    S.CaptureAccessories(state)

    -- Animated utiliza os welds individuais.
    S.BuildIndividualWelds(state)

    if not state.PartPairs or not next(state.PartPairs) then
        return false
    end

    state.Active = true

    S.UpdatePartSizes(state)
    S.UpdateAccessories(state)

    S.HideLocalOriginal(state)
    S.MonitorLocalSizeChanges(state)

    return true
end

--========================================================--
-- LIMPEZA DAS CONEXÕES LOCAIS
--========================================================--

S.DisconnectLocalState = function(state)
    if not state then
        return
    end

    for _, connection in ipairs(state.Connections or {}) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(state.Connections or {})
end

--========================================================--
-- LIMPEZA DO JOGADOR
--========================================================--

S.CleanupLocal = function()
    local state = S.LocalState

    if state then
        state.Destroyed = true
        state.Active = false

        S.DisconnectLocalState(state)

        if state.Rig then
            S.GeneratedRigs[state.Rig] = nil

            if state.Rig.Parent then
                state.Rig:Destroy()
            end
        end

        S.RestoreLocalOriginal(state)
    end

    S.StopClassicAnimations()

    if S.PlayerUpdateConnection then
        S.PlayerUpdateConnection:Disconnect()
        S.PlayerUpdateConnection = nil
    end

    S.LocalState = nil
    S.LocalCharacter = nil
    S.LocalHumanoid = nil
    S.LocalRoot = nil
    S.LocalR6 = nil
    S.LocalR6Humanoid = nil
    S.AnimationController = nil
end

--========================================================--
-- CONFIGURAÇÃO DO JOGADOR
--========================================================--

S.SetupLocal = function(character)
    if not S.RUNNING or not character then
        return
    end

    S.CleanupLocal()

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then
        return
    end

    S.LocalCharacter = character
    S.LocalHumanoid = humanoid
    S.LocalRoot = root

    -- O R6 usa a aparência fixa definida na Parte A.
    -- Não copia a aparência do jogador.

    local rig = S.CreateR6(
        "R6_Player_" .. S.HttpService:GenerateGUID(false)
    )

    if not rig then
        return
    end

    local state = {
        NPC = character,
        Original = character,
        Source = character,
        Rig = rig,

        Connections = {},

        Destroyed = false,
        Active = false,

        AccessoryData = {},
        PartData = {},
        PartPairs = {},
    }

    S.LocalState = state
    S.LocalR6 = rig
    S.LocalR6Humanoid = rig:FindFirstChildOfClass("Humanoid")

    local prepared = false

    if S.CurrentMode == "Classic" then
        prepared = S.PrepareClassicRig(state)
    else
        prepared = S.PrepareAnimatedRig(state)
    end

    if not prepared then
        S.CleanupLocal()
        return
    end

    if S.CurrentMode == "Classic" then
        S.LoadClassicAnimations()
    end

    S.PlayerUpdateConnection = S.RunService.Heartbeat:Connect(function()
        if not S.RUNNING
            or S.LocalState ~= state
            or state.Destroyed then

            return
        end

        S.UpdateLocalSizes()
        S.EnforceLocalOriginalHidden(state)

        if S.CurrentMode == "Classic" then
            S.UpdateClassicAnimation()
        end
    end)

    table.insert(
        state.Connections,

        character.AncestryChanged:Connect(function()
            if state.Destroyed then
                return
            end

            if not character.Parent then
                S.CleanupLocal()
            end
        end)
    )
end

--========================================================--
-- TROCA DE MODO
--========================================================--

S.ChangeMode = function(mode)
    if not S.RUNNING then
        return
    end

    if mode ~= "Classic" and mode ~= "Animated" then
        return
    end

    if S.CurrentMode == mode then
        return
    end

    S.CurrentMode = mode

    local character = S.LocalPlayer.Character

    if character then
        S.SetupLocal(character)
    end

    if S.RefreshModeButtons then
        S.RefreshModeButtons()
    end

    if S.ModeLabel then
        S.ModeLabel.Text = "Modo: " .. mode
    end
end

