S.FindNPCSourcePart = function(source, targetName)
    if not source then return nil end

    if not targetName then
        return source:FindFirstChild(
            "HumanoidRootPart",
            true
        )
        or source:FindFirstChild("Torso", true)
        or source:FindFirstChild("UpperTorso", true)
        or source:FindFirstChild("Head", true)
    end

    for _, name in ipairs(
        S.NPCPartMap[targetName] or {targetName}
    ) do

        local part = source:FindFirstChild(name, true)

        if part and part:IsA("BasePart") then
            return part
        end
    end

    return nil
end

S.GetBodyPart = function(rig, name)
    if not rig then return nil end

    local part = rig:FindFirstChild(name)

    if part and part:IsA("BasePart") then
        return part
    end

    return nil
end

