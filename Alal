        end)
    )

    --====================================================--
    -- ARRASTAR INTERFACE
    -- PC E CELULAR
    --====================================================--

    local dragging = false
    local dragStart = nil
    local startPosition = nil
    local dragInput = nil

    local function UpdateDrag(input)
        if not dragging or not dragStart or not startPosition then
            return
        end

        local delta = input.Position - dragStart

        Main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,

            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end

    S.Connect(
        S.GlobalConnections,

        TopBar.InputBegan:Connect(function(input)

            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then

                dragging = true

                dragStart = input.Position
                startPosition = Main.Position

                dragInput = input

                S.Connect(
                    S.GlobalConnections,

                    input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End then
                            dragging = false
                            dragInput = nil
                        end
                    end)
                )
            end
        end)
    )

    S.Connect(
        S.GlobalConnections,

        UserInputService.InputChanged:Connect(function(input)

            if dragging
                and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then

                UpdateDrag(input)
            end
        end)
    )

    --====================================================--
    -- CONTADOR DE NPCs
    --====================================================--

    S.RefreshNPCCount = function()
        local count = 0

        for model, state in pairs(S.NPCStates) do

            if model
                and model.Parent
                and state
                and state.Rig
                and state.Rig.Parent then

                count += 1
            end
        end

        NPCCountLabel.Text = "NPCs ativos: " .. count

        return count
    end

    --====================================================--
    -- ATUALIZAÇÃO DO SISTEMA NPC
    --====================================================--

    S.RefreshNPCSystem = function()

        if not S.RUNNING then
            return
        end

        S.ScanNPCs()
        S.UpdateNPCs()

        S.RefreshNPCCount()
    end

    --====================================================--
    -- MONITORAMENTO CONTÍNUO
    --====================================================--

    local scanTimer = 0

    S.Connect(
        S.GlobalConnections,

        RunService.Heartbeat:Connect(function(deltaTime)

            if not S.RUNNING then
                return
            end

            scanTimer += deltaTime

            local interval =
                S.CONFIG.SCAN_INTERVAL or 2

            if scanTimer >= interval then

                scanTimer = 0

                S.RefreshNPCSystem()
            end
        end)
    )

    --====================================================--
    -- STATUS INICIAL
    --====================================================--

    S.RefreshModeButtons()

    StatusLabel.Text = "Sistema: Ativo"
    StatusLabel.TextColor3 = COLORS.Green

    --====================================================--
    -- PRIMEIRA VERIFICAÇÃO
    --====================================================--

    task.defer(function()

        if not S.RUNNING then
            return
        end

        S.RefreshNPCSystem()
    end)

    print("[R6System] Parte D carregada.")

end

--========================================================--
-- R6 AVATAR + NPCs
-- PARTE E/6
-- Last Survivor, respawn, inicialização e encerramento
--========================================================--

do

    --====================================================--
    -- VARIÁVEIS
    --====================================================--

    local Players = S.Players
    local LocalPlayer = S.LocalPlayer
    local Workspace = S.Workspace

    S.LastSurvivor = S.LastSurvivor or {}

    S.LastSurvivor.Running = false
    S.LastSurvivor.Sound = nil
    S.LastSurvivor.Generation = 0

    --====================================================--
    -- CONFIGURAÇÃO DA MÚSICA
    --====================================================--

    S.LastSurvivor.AssetId =
        S.CONFIG.LAST_SURVIVOR_SOUND
        or "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3"

    S.LastSurvivor.FileName = "R6_LastSurvivor.mp3"

    --====================================================--
    -- LOCALIZAR PASTAS DOS JOGADORES
    --====================================================--

    S.GetLastSurvivorFolders = function()

        local killers =
            Workspace:FindFirstChild("Killers")

        local survivors =
            Workspace:FindFirstChild("Survivors")

        return killers, survivors
    end

    --====================================================--
    -- VERIFICAR SE MODELO ESTÁ VIVO
    --====================================================--

    S.IsLastSurvivorAlive = function(model)

        if not model or not model.Parent then
            return false
        end

        local humanoid =
            model:FindFirstChildOfClass("Humanoid")

        if humanoid then
            return humanoid.Health > 0
        end

        return true
    end

    --====================================================--
    -- VERIFICAR CONDIÇÃO DE LAST SURVIVOR
    --====================================================--

    S.ShouldPlayLastSurvivor = function()

        local killers, survivors =
            S.GetLastSurvivorFolders()

        if not killers or not survivors then
            return false
        end

        local localCharacter = LocalPlayer.Character

        if not localCharacter then
            return false
        end

        local isKiller =
            localCharacter:IsDescendantOf(killers)

        if not isKiller then
            return false
        end

        local aliveCount = 0

        for _, survivor in ipairs(survivors:GetChildren()) do

            if S.IsLastSurvivorAlive(survivor) then
                aliveCount += 1
            end
        end

        return aliveCount == 1
    end

    --====================================================--
    -- PARAR MÚSICA
    --====================================================--

    S.StopLastSurvivorMusic = function()

        S.LastSurvivor.Generation += 1
        S.LastSurvivor.Running = false

        local sound = S.LastSurvivor.Sound

        if sound then

            pcall(function()
                sound:Stop()
                sound:Destroy()
            end)

            S.LastSurvivor.Sound = nil
        end
    end

    --====================================================--
    -- OBTER ARQUIVO DA MÚSICA
    --====================================================--

    S.GetLastSurvivorAsset = function()

        if not getcustomasset or not writefile or not isfile then
            return nil
        end

        local fileName =
            S.LastSurvivor.FileName

        if not isfile(fileName) then

            local success, data = pcall(function()

                return game:HttpGet(
                    S.LastSurvivor.AssetId
                )
            end)

            if not success or not data then
                warn("[R6System] Não foi possível baixar a música.")
                return nil
            end

            local writeSuccess = pcall(function()
                writefile(fileName, data)
            end)

            if not writeSuccess then
                return nil
            end
        end

        local success, asset = pcall(function()
            return getcustomasset(fileName)
        end)

        if success then
            return asset
        end

        return nil
    end

    --====================================================--
    -- INICIAR MÚSICA
    --====================================================--

    S.PlayLastSurvivorMusic = function()

        if S.LastSurvivor.Running then
            return
        end

        S.LastSurvivor.Running = true

        local generation =
            S.LastSurvivor.Generation + 1

        S.LastSurvivor.Generation = generation

        task.spawn(function()

            local asset =
                S.GetLastSurvivorAsset()

            if not asset then

                if S.LastSurvivor.Generation == generation then
                    S.LastSurvivor.Running = false
                end

                return
            end

            if not S.RUNNING
                or S.LastSurvivor.Generation ~= generation then
                return
            end

            local sound = Instance.new("Sound")

            sound.Name = "R6_LastSurvivorMusic"
            sound.SoundId = asset

            sound.Volume = 0.7
            sound.Looped = true

            sound.Parent =
                Workspace.CurrentCamera
                or Workspace

            S.LastSurvivor.Sound = sound

            local loaded = pcall(function()
                sound:Play()
            end)

            if not loaded then

                sound:Destroy()

                S.LastSurvivor.Sound = nil
                S.LastSurvivor.Running = false

                return
            end
        end)
    end

    --====================================================--
    -- MONITORAR LAST SURVIVOR
    --====================================================--

    S.UpdateLastSurvivor = function()

        if not S.RUNNING then
            S.StopLastSurvivorMusic()
            return
        end

        if S.ShouldPlayLastSurvivor() then
            S.PlayLastSurvivorMusic()
        else
            if S.LastSurvivor.Running then
                S.StopLastSurvivorMusic()
            end
        end
    end

    --====================================================--
    -- MONITORAMENTO DAS PASTAS
    --====================================================--

    local function ConnectLastSurvivorFolder(folder)

        if not folder then return end

        S.Connect(
            S.GlobalConnections,

            folder.ChildAdded:Connect(function()
                task.defer(S.UpdateLastSurvivor)
            end)
        )

        S.Connect(
            S.GlobalConnections,

            folder.ChildRemoved:Connect(function()
                task.defer(S.UpdateLastSurvivor)
            end)
        )
    end

    local killers, survivors =
        S.GetLastSurvivorFolders()

    ConnectLastSurvivorFolder(killers)
    ConnectLastSurvivorFolder(survivors)

    --====================================================--
    -- MONITORAMENTO PERIÓDICO
    --====================================================--

    S.Connect(
        S.GlobalConnections,

        S.RunService.Heartbeat:Connect(function()

            if not S.RUNNING then
                return
            end

            S.UpdateLastSurvivor()
        end)
    )

    --====================================================--
    -- RESPAWN DO PERSONAGEM
    --====================================================--

    S.Connect(
        S.GlobalConnections,

        LocalPlayer.CharacterAdded:Connect(function(character)

            task.spawn(function()

                local humanoid =
                    character:WaitForChild("Humanoid", 15)

                local root =
                    character:WaitForChild("HumanoidRootPart", 15)

                if not humanoid or not root then
                    return
                end

                if not S.RUNNING then
                    return
                end

                task.wait(0.25)

                S.SetupLocal(character)

                S.UpdateLastSurvivor()
            end)
        end)
    )

    --====================================================--
    -- DESLIGAR SISTEMA
    --====================================================--

    S.Shutdown = function()

        if not S.RUNNING then
            return
        end

        S.RUNNING = false

        -- Parar música.
        S.StopLastSurvivorMusic()

        -- Limpar personagem local e restaurar aparência.
        S.CleanupLocal()

        -- Desconectar monitoramentos globais.
        S.DisconnectAll(S.GlobalConnections)

        -- Limpar NPCs.
        for model, state in pairs(S.NPCStates) do

            if S.CleanupNPC then

                pcall(function()
                    S.CleanupNPC(model)
                end)

            else

                if state and state.Rig then

                    S.GeneratedRigs[state.Rig] = nil

                    pcall(function()
                        state.Rig:Destroy()
                    end)
                end
            end
        end

        table.clear(S.NPCStates)

        -- Remover interface.
        local interface =
            S.UI or S.ScreenGui

        if interface then

            pcall(function()
                interface:Destroy()
            end)
        end

        S.UI = nil
        S.ScreenGui = nil

        S.Main = nil
        S.Reopen = nil

        S.NPCCountLabel = nil
        S.StatusLabel = nil
        S.ModeLabel = nil

        print("[R6System] Sistema encerrado.")
    end

    --====================================================--
    -- INICIALIZAÇÃO FINAL
    --====================================================--

    if LocalPlayer.Character then

        task.spawn(function()

            local character = LocalPlayer.Character

            local humanoid =
                character:WaitForChild("Humanoid", 15)

            local root =
                character:WaitForChild("HumanoidRootPart", 15)

            if humanoid and root and S.RUNNING then
                S.SetupLocal(character)
            end
        end)
    end

    task.defer(function()

        if not S.RUNNING then
            return
        end

        if S.RefreshNPCSystem then
            S.RefreshNPCSystem()
        end

        S.UpdateLastSurvivor()
    end)

    print("[R6System] Parte E carregada.")
    print("[R6System] Inicialização concluída.")

end
