--========================================================--
-- OCULTAÇÃO DO PERSONAGEM ORIGINAL
--========================================================--

S.EnforceLocalObjectHidden = function(object)
    if not object then
        return
    end

    if object:IsA("BasePart") then

        object.Transparency = 1
        object.LocalTransparencyModifier = 1
        object.CastShadow = false

    elseif object:IsA("Decal")
        or object:IsA("Texture") then

        object.Transparency = 1

    elseif object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Beam")
        or object:IsA("Fire")
        or object:IsA("Smoke")
        or object:IsA("Sparkles") then

        object.Enabled = false

    elseif object:IsA("BillboardGui")
        or object:IsA("SurfaceGui")
        or object:IsA("Highlight") then

        object.Enabled = false
    end
end

--========================================================--
-- CAPTURAR TRANSPARÊNCIA ORIGINAL
--========================================================--

S.CaptureLocalTransparency = function(object)
    if not object then
        return
    end

    if object:GetAttribute("R6OriginalTransparency") == nil then

        if object:IsA("BasePart")
            or object:IsA("Decal")
            or object:IsA("Texture") then

            object:SetAttribute(
                "R6OriginalTransparency",
                object.Transparency
            )
        end
    end

    if object:IsA("BasePart")
        and object:GetAttribute("R6OriginalCastShadow") == nil then

        object:SetAttribute(
            "R6OriginalCastShadow",
            object.CastShadow
        )
    end
end

--========================================================--
-- MONITORAMENTO DOS OBJETOS ORIGINAIS
--========================================================--

S.MonitorLocalObject = function(state, object)
    if not state or not object then
        return
    end

    state.MonitoredObjects = state.MonitoredObjects or {}

    if state.MonitoredObjects[object] then
        return
    end

    state.MonitoredObjects[object] = true

    S.CaptureLocalTransparency(object)
    S.EnforceLocalObjectHidden(object)
end

--========================================================--
-- OCULTAR PERSONAGEM ORIGINAL
--========================================================--

S.HideLocalOriginal = function(state)
    if not state or not state.Source then
        return
    end

    state.MonitoredObjects = {}

    for _, object in ipairs(state.Source:GetDescendants()) do
        S.MonitorLocalObject(state, object)
    end

    S.Connect(
        state.Connections,

        state.Source.DescendantAdded:Connect(function(object)

            if not state.Active then
                return
            end

            S.MonitorLocalObject(state, object)
        end)
    )
end

--========================================================--
-- GARANTIR QUE O ORIGINAL CONTINUE OCULTO
--========================================================--

S.EnforceLocalOriginalHidden = function(state)
    if not state or not state.Source then
        return
    end

    for object in pairs(state.MonitoredObjects or {}) do

        if object and object.Parent then
            S.EnforceLocalObjectHidden(object)
        end
    end
end

--========================================================--
-- RESTAURAR PERSONAGEM ORIGINAL
--========================================================--

S.RestoreLocalOriginal = function(state)
    if not state then
        return
    end

    for object in pairs(state.MonitoredObjects or {}) do

        if object and object.Parent then

            if object:IsA("BasePart")
                or object:IsA("Decal")
                or object:IsA("Texture") then

                local originalTransparency =
                    object:GetAttribute("R6OriginalTransparency")

                if originalTransparency ~= nil then
                    object.Transparency = originalTransparency
                end

                if object:IsA("BasePart") then

                    local originalShadow =
                        object:GetAttribute("R6OriginalCastShadow")

                    if originalShadow ~= nil then
                        object.CastShadow = originalShadow
                    end

                    object.LocalTransparencyModifier = 0
                end

            elseif object:IsA("ParticleEmitter")
                or object:IsA("Trail")
                or object:IsA("Beam")
                or object:IsA("Fire")
                or object:IsA("Smoke")
                or object:IsA("Sparkles") then

                object.Enabled = true

            elseif object:IsA("BillboardGui")
                or object:IsA("SurfaceGui")
                or object:IsA("Highlight") then

                object.Enabled = true
            end
        end
    end

    state.MonitoredObjects = {}
end

--========================================================--
-- ATUALIZAR TAMANHOS DO R6 LOCAL
--========================================================--

S.UpdateLocalSizes = function(state)
    if not state or not state.Active then
        return
    end

    S.UpdatePartSizes(state)
    S.UpdateAccessories(state)

    S.EnforceLocalOriginalHidden(state)
end

--========================================================--
-- MONITORAR ALTERAÇÕES DE TAMANHO
--========================================================--

S.MonitorLocalSizeChanges = function(state)
    if not state or not state.Source then
        return
    end

    state.SizeMonitored = state.SizeMonitored or {}

    for _, object in ipairs(state.Source:GetDescendants()) do

        if object:IsA("BasePart")
            and not state.SizeMonitored[object] then

            state.SizeMonitored[object] = true

            S.Connect(
                state.Connections,

                object:GetPropertyChangedSignal("Size"):Connect(function()

                    if not state.Active then
                        return
                    end

                    S.UpdateLocalSizes(state)
                end)
            )
        end
    end

    S.Connect(
        state.Connections,

        state.Source.DescendantAdded:Connect(function(object)

            if not state.Active then
                return
            end

            if object:IsA("BasePart")
                and not state.SizeMonitored[object] then

                state.SizeMonitored[object] = true

                S.Connect(
                    state.Connections,

                    object:GetPropertyChangedSignal("Size"):Connect(function()

                        if state.Active then
                            S.UpdateLocalSizes(state)
                        end
                    end)
                )
            end
        end)
    )
end

--========================================================--
-- ANIMAÇÕES CLASSIC
--========================================================--

S.StopClassicAnimations = function()
    for name, track in pairs(S.AnimationTracks or {}) do

        if track then
            pcall(function()
                track:Stop(0.15)
                track:Destroy()
            end)
        end

        S.AnimationTracks[name] = nil
    end

    S.AnimationController = nil
    S.CurrentAnimation = nil
end

--========================================================--
-- CARREGAR ANIMAÇÕES
--========================================================--

S.LoadClassicAnimations = function(humanoid)
    S.StopClassicAnimations()

    if not humanoid then
        return false
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")

    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    S.AnimationController = animator

    for name, animationId in pairs(S.CONFIG.ANIMATIONS) do

        local animation = Instance.new("Animation")
        animation.Name = "R6_" .. name
        animation.AnimationId = animationId

        local success, track = pcall(function()
            return animator:LoadAnimation(animation)
        end)

        animation:Destroy()

        if success and track then

            if name == "Idle" then
                track.Priority = Enum.AnimationPriority.Idle

            elseif name == "Walk"
                or name == "Run" then

                track.Priority = Enum.AnimationPriority.Movement

            else
                track.Priority = Enum.AnimationPriority.Action
            end

            track.Looped = (
                name == "Idle"
                or name == "Walk"
                or name == "Run"
                or name == "Climb"
            )

            S.AnimationTracks[name] = track
        end
    end

    return true
end

--========================================================--
-- PARAR ANIMAÇÃO ATUAL
--========================================================--

S.StopCurrentClassicAnimation = function()
    if not S.CurrentAnimation then
        return
    end

    local track = S.AnimationTracks[S.CurrentAnimation]

    if track then
        pcall(function()
            track:Stop(0.15)
        end)
    end

    S.CurrentAnimation = nil
end

--========================================================--
-- TOCAR ANIMAÇÃO
--========================================================--

S.PlayClassicAnimation = function(name, speed)
    if not name then
        return
    end

    local track = S.AnimationTracks[name]

    if not track then
        return
    end

    if S.CurrentAnimation == name and track.IsPlaying then

        if speed then
            pcall(function()
                track:AdjustSpeed(speed)
            end)
        end

        return
    end

    S.StopCurrentClassicAnimation()

    S.CurrentAnimation = name

    pcall(function()
        track:Play(0.15)

        if speed then
            track:AdjustSpeed(speed)
        end
    end)
end

--========================================================--
-- ATUALIZAR ANIMAÇÃO CLASSIC
--========================================================--

S.UpdateClassicAnimation = function()
    local state = S.LocalState

    if not state
        or not state.Active
        or state.Mode ~= "Classic" then
        return
    end

    local sourceHumanoid = state.SourceHumanoid
    local rigHumanoid = state.RigHumanoid

    if not sourceHumanoid or not rigHumanoid then
        return
    end

    if sourceHumanoid.Health <= 0 then
        S.PlayClassicAnimation("Idle")
        return
    end

    local sourceRoot = state.SourceRoot

    if not sourceRoot or not sourceRoot.Parent then
        return
    end

    local velocity = sourceRoot.AssemblyLinearVelocity
    local horizontalSpeed = Vector3.new(
        velocity.X,
        0,
        velocity.Z
    ).Magnitude

    local stateType = sourceHumanoid:GetState()

    local animationName = "Idle"
    local animationSpeed = 1

    if stateType == Enum.HumanoidStateType.Jumping then

        animationName = "Jump"

    elseif stateType == Enum.HumanoidStateType.Freefall then

        animationName = "Fall"

    elseif stateType == Enum.HumanoidStateType.Climbing then

        animationName = "Climb"

    elseif horizontalSpeed > 0.5 then

        animationName = "Walk"

        animationSpeed = math.max(
            S.CONFIG.MIN_ANIMATION_SPEED,

            horizontalSpeed /
            math.max(S.CONFIG.REFERENCE_SPEED, 0.001)
        )

        animationSpeed *=
            S.CONFIG.ANIMATION_SPEED_MULTIPLIER
    end

    S.PlayClassicAnimation(
        animationName,
        animationSpeed
    )
end

--========================================================--
-- PREPARAR MODO CLASSIC
--========================================================--

S.PrepareClassicRig = function(state)
    if not state
        or not state.Source
        or not state.Rig then
        return false
    end

    state.Active = false
    state.Mode = "Classic"

    state.PartPairs = {}
    state.AccessoryData = {}

    -- Captura os acessórios.
    S.CaptureAccessories(state)

    -- IMPORTANTE:
    -- Registra os pares sem destruir os Motor6D.
    -- Não cria WeldConstraint neste modo.
    S.BuildClassicPartPairs(state)

    if not state.RigRoot then
        state.RigRoot =
            state.Rig:FindFirstChild("HumanoidRootPart")
    end

    if not state.SourceRoot
        or not state.SourceRoot.Parent
        or not state.RigRoot then

        return false
    end

    -- O root do R6 fica ancorado para acompanhar
    -- o personagem sem depender da física.
    state.RigRoot.Anchored = true

    state.Active = true

    -- Posiciona inicialmente o R6.
    state.Rig:PivotTo(
        state.SourceRoot.CFrame
        * CFrame.new(0, S.CONFIG.HEIGHT_OFFSET, 0)
    )

    S.UpdateLocalSizes(state)

    S.HideLocalOriginal(state)
    S.MonitorLocalSizeChanges(state)

    return true
end

--========================================================--
-- PREPARAR MODO ANIMATED
--========================================================--

S.PrepareAnimatedRig = function(state)
    if not state
        or not state.Source
        or not state.Rig then
        return false
    end

    state.Active = false
    state.Mode = "Animated"

    state.PartPairs = {}
    state.AccessoryData = {}

    S.CaptureAccessories(state)

    -- Animated utiliza Welds individuais.
    S.BuildIndividualWelds(state)

    local count = 0

    for _, pair in pairs(state.PartPairs) do

        if pair.Source and pair.Target then
            count += 1
        end
    end

    if count == 0 then
        return false
    end

    state.Active = true

    S.UpdateLocalSizes(state)

    S.HideLocalOriginal(state)
    S.MonitorLocalSizeChanges(state)

    return true
end

--========================================================--
-- DESCONECTAR ESTADO LOCAL
--========================================================--

S.DisconnectLocalState = function(state)
    if not state then
        return
    end

    state.Active = false

    S.DisconnectAll(state.Connections)

    state.MonitoredObjects = {}
    state.SizeMonitored = {}
end

--========================================================--
-- LIMPEZA DO PERSONAGEM LOCAL
--========================================================--

S.CleanupLocal = function()
    local state = S.LocalState

    if state then

        S.DisconnectLocalState(state)

        S.RestoreLocalOriginal(state)

        if state.Rig then

            S.GeneratedRigs[state.Rig] = nil

            pcall(function()
                state.Rig:Destroy()
            end)
        end
    end

    S.StopClassicAnimations()

    if S.PlayerUpdateConnection then

        pcall(function()
            S.PlayerUpdateConnection:Disconnect()
        end)

        S.PlayerUpdateConnection = nil
    end

    S.LocalR6 = nil
    S.LocalR6Humanoid = nil

    S.LocalCharacter = nil
    S.LocalHumanoid = nil
    S.LocalRoot = nil

    S.LocalState = {
        Source = nil,
        Rig = nil,
        Active = false,

        Connections = {},
        PartPairs = {},

        AccessoryData = {},
        OriginalVisibility = {},
        MonitoredObjects = {},
        SizeMonitored = {},
    }
end

--========================================================--
-- CONFIGURAR PERSONAGEM LOCAL
--========================================================--

S.SetupLocal = function(character)
    if not S.RUNNING or not character then
        return false
    end

    -- Limpa a configuração anterior.
    S.CleanupLocal()

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then
        return false
    end

    -- Cria o R6.
    local rig, rigHumanoid, rigRoot =
        S.CreateR6(character.Name .. "_R6")

    if not rig then
        return false
    end

    local state = {
        Source = character,

        SourceHumanoid = humanoid,
        SourceRoot = root,

        Rig = rig,
        RigHumanoid = rigHumanoid,
        RigRoot = rigRoot,

        Active = false,
        Mode = S.CurrentMode,

        Connections = {},
        PartPairs = {},

        AccessoryData = {},
        OriginalVisibility = {},
        MonitoredObjects = {},
        SizeMonitored = {},
    }

    S.LocalState = state

    S.LocalCharacter = character
    S.LocalHumanoid = humanoid
    S.LocalRoot = root

    S.LocalR6 = rig
    S.LocalR6Humanoid = rigHumanoid

    --====================================================--
    -- PREPARAÇÃO DO MODO
    --====================================================--

    local prepared = false

    if S.CurrentMode == "Classic" then

        prepared = S.PrepareClassicRig(state)

        if prepared then
            S.LoadClassicAnimations(rigHumanoid)
        end

    else

        prepared = S.PrepareAnimatedRig(state)
    end

    if not prepared then

        warn(
            "[R6System] Não foi possível preparar o personagem local."
        )

        S.CleanupLocal()

        return false
    end

    --====================================================--
    -- ATUALIZAÇÃO CONTÍNUA
    --====================================================--

    S.PlayerUpdateConnection =
        S.RunService.Heartbeat:Connect(function()

            if not S.RUNNING
                or not state.Active then
                return
            end

            if not character.Parent
                or not state.Rig
                or not state.Rig.Parent then
                return
            end

            if S.CurrentMode == "Classic" then

                -- Acompanha o personagem original.
                -- O PivotTo movimenta o rig inteiro,
                -- preservando os Motor6D internos.
                if state.SourceRoot
                    and state.SourceRoot.Parent
                    and state.RigRoot
                    and state.RigRoot.Parent then

                    local targetCFrame =
                        state.SourceRoot.CFrame
                        * CFrame.new(
                            0,
                            S.CONFIG.HEIGHT_OFFSET,
                            0
                        )

                    state.Rig:PivotTo(targetCFrame)
                end

                S.UpdateLocalSizes(state)
                S.UpdateClassicAnimation()

            elseif S.CurrentMode == "Animated" then

                S.UpdateLocalSizes(state)
            end

            S.EnforceR6VisualProperties(state.Rig)
        end)

    --====================================================--
    -- REMOÇÃO DO PERSONAGEM
    --====================================================--

    S.Connect(
        state.Connections,

        character.AncestryChanged:Connect(function(_, parent)

            if not parent then

                if S.LocalState == state then
                    S.CleanupLocal()
                end
            end
        end)
    )

    return true
end

--========================================================--
-- ALTERAR MODO
--========================================================--

S.ChangeMode = function(mode)
    if not S.RUNNING then
        return
    end

    if mode ~= "Classic" and mode ~= "Animated" then
        return
    end

    if S.CurrentMode == mode then
        return
    end

    S.CurrentMode = mode
    S.CONFIG.MODE = mode

    local character = S.LocalPlayer.Character

    if character then
        S.SetupLocal(character)
    end

    if S.RefreshModeButtons then
        S.RefreshModeButtons()
    end

    print("[R6System] Modo alterado para:", mode)
end

