function COS:SetMovementEnabled(Value)

    self.Config.Movement.Enabled =
        Value == true

    if not self.Config.Movement.Enabled then
        self:StopMovement()
    end

    self:Log(
        "MOVEMENT",
        self.Config.Movement.Enabled
            and "Movimentação habilitada."
            or "Movimentação desabilitada."
    )
end

function COS:SetWalkSpeed(Value)

    Value = tonumber(Value)

    if not Value then
        return false
    end

    Value = math.clamp(Value, 0, 16)

    self.Config.Movement.WalkSpeed = Value

    local Humanoid = self:GetHumanoid()

    if Humanoid then
        Humanoid.WalkSpeed = Value
    end

    return true
end

function COS:SetJumpPower(Value)

    Value = tonumber(Value)

    if not Value then
        return false
    end

    Value = math.clamp(Value, 0, 50)

    self.Config.Movement.JumpPower = Value

    local Humanoid = self:GetHumanoid()

    if Humanoid then

        Humanoid.UseJumpPower = true
        Humanoid.JumpPower = Value

    end

    return true
end

--==============================================================
-- MANUAL MOVEMENT COMMAND
--==============================================================

function COS:MoveToPosition(Position)

    if not self.Config.Movement.Enabled then
        return false
    end

    if typeof(Position) ~= "Vector3" then
        return false
    end

    local Humanoid = self:GetHumanoid()

    if not Humanoid or Humanoid.Health <= 0 then
        return false
    end

    if not self:IsPositionAvailable(Position) then

        self:Log(
            "MOVEMENT",
            "Destino recusado: posição não validada."
        )

        return false
    end

    Humanoid:MoveTo(Position)

    self.Movement.CurrentTarget = Position

    self:AddDecision(
        "MOVEMENT",
        "Comando de movimentação autorizado.",
        self.Decision.Priority.Medium
    )

    return true
end

--==============================================================
-- MOVEMENT STOP
--==============================================================

function COS:StopMovement()

    local Humanoid = self:GetHumanoid()

    if Humanoid then
        Humanoid:Move(Vector3.zero)
    end

    self.Movement.CurrentTarget = nil
    self.Movement.Running = false

    self:Log(
        "MOVEMENT",
        "Movimentação interrompida."
    )
end

--==============================================================
-- PERIODIC DECISION LOOP
--==============================================================

function COS:StartDecisionLoop()

    if self.Decision.Running then
        return
    end

    self.Decision.Running = true

    task.spawn(function()

        while self.Decision.Running
            and self.State.Running do

            if self.Config.General.AutonomousMode then

                self:Think()

            end

            task.wait(2)

        end

    end)

    self:Log(
        "DECISION",
        "Ciclo de decisões iniciado."
    )
end

function COS:StopDecisionLoop()

    self.Decision.Running = false

    self:Log(
        "DECISION",
        "Ciclo de decisões interrompido."
    )
end

