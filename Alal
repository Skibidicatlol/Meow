--========================================================--
-- COLISÕES
--========================================================--

S.EnforcePartCollision = function(part)
    if not part or not part:IsA("BasePart") then
        return
    end

    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Massless = true
end

S.DisableR6Collision = function(rig)
    if not rig then
        return
    end

    for _, object in ipairs(rig:GetDescendants()) do
        if object:IsA("BasePart") then
            S.EnforcePartCollision(object)
        end
    end
end

--========================================================--
-- PROPRIEDADES VISUAIS
--========================================================--

S.EnforceR6VisualProperties = function(rig)
    if not rig then
        return
    end

    for _, object in ipairs(rig:GetDescendants()) do
        if object:IsA("BasePart") then

            if object.Name == "HumanoidRootPart" then
                object.Transparency = 1
                object.LocalTransparencyModifier = 1
                object.CastShadow = false
            end

            S.EnforcePartCollision(object)
        end
    end
end

--========================================================--
-- CRIAÇÃO DO R6
--========================================================--

S.CreateR6 = function(sourceOrName)
    local name

    if typeof(sourceOrName) == "Instance" then
        name = sourceOrName.Name

    elseif type(sourceOrName) == "string" then
        name = sourceOrName
    end

    name = name or (
        "R6Avatar_" ..
        S.HttpService:GenerateGUID(false)
    )

    local description = Instance.new("HumanoidDescription")

    description.HeadColor = S.CONFIG.BODY_COLOR
    description.TorsoColor = S.CONFIG.BODY_COLOR
    description.LeftArmColor = S.CONFIG.BODY_COLOR
    description.RightArmColor = S.CONFIG.BODY_COLOR
    description.LeftLegColor = S.CONFIG.BODY_COLOR
    description.RightLegColor = S.CONFIG.BODY_COLOR

    description.Shirt = 0
    description.Pants = 0
    description.GraphicTShirt = 0

    description.HatAccessory = S.CONFIG.HAT_ID
    description.FaceAccessory = S.CONFIG.EYES_ID

    local success, rig = pcall(function()
        return S.Players:CreateHumanoidModelFromDescriptionAsync(
            description,
            Enum.HumanoidRigType.R6
        )
    end)

    description:Destroy()

    if not success or not rig then
        warn("[R6] Falha ao criar:", name, rig)
        return nil
    end

    rig.Name = name
    rig:SetAttribute("R6ReplacementTag", S.TAG)

    S.GeneratedRigs[rig] = true

    local humanoid = rig:FindFirstChildOfClass("Humanoid")
    local root = rig:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then
        S.GeneratedRigs[rig] = nil
        rig:Destroy()
        return nil
    end

    humanoid.DisplayDistanceType =
        Enum.HumanoidDisplayDistanceType.None

    humanoid.BreakJointsOnDeath = false
    humanoid.AutoRotate = false
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0

    pcall(function()
        humanoid.EvaluateStateMachine = false
    end)

    for _, object in ipairs(rig:GetDescendants()) do

        if object:IsA("BasePart") then

            if object.Name == "HumanoidRootPart" then
                object.Transparency = 1
                object.LocalTransparencyModifier = 1
                object.CastShadow = false

            else
                object.Transparency = 0
                object.LocalTransparencyModifier = 0
                object.CastShadow = true
            end

            S.EnforcePartCollision(object)

        elseif object:IsA("Decal")
            or object:IsA("Texture") then

            object.Transparency = 0
        end
    end

    -- O root permanece ancorado.
    -- O acompanhamento do personagem será feito pela Parte C.
    root.Anchored = true

    rig.Parent = S.Workspace

    return rig, humanoid, root
end

