function COS:AddPerceptionEvent(Category, Information)

    local Event = {
        Category = tostring(Category),
        Information = Information,
        Timestamp = os.date("%H:%M:%S"),
        Clock = self:Now(),
    }

    table.insert(
        self.Perception.Events,
        Event
    )

    while #self.Perception.Events >
        self.Perception.MaximumEvents do

        table.remove(
            self.Perception.Events,
            1
        )

    end

    if self.Config.Debug.ShowPerceptionEvents then

        self:Log(
            "PERCEPTION",
            Category
        )

    end

    return Event
end

