--==============================================================
-- CONNECTION STORAGE
--==============================================================

COS.Connections = {}

function COS:AddConnection(Connection)

    if Connection then
        table.insert(self.Connections, Connection)
    end

    return Connection
end

function COS:DisconnectAll()

    for _, Connection in ipairs(self.Connections) do

        pcall(function()
            Connection:Disconnect()
        end)

    end

    table.clear(self.Connections)
end

--==============================================================
-- UTILITY FUNCTIONS
--==============================================================

function COS:Now()

    return os.clock()
end

function COS:FormatTime(Seconds)

    return string.format("%.1f", Seconds)
end

function COS:Trim(Text)

    if typeof(Text) ~= "string" then
        return ""
    end

    return Text:match("^%s*(.-)%s*$") or ""
end

function COS:Normalize(Text)

    Text = self:Trim(Text)

    return string.lower(Text)
end

function COS:SafeCall(Function, ...)

    local Arguments = {...}

    local Success, Result = pcall(function()

        return Function(unpack(Arguments))

    end)

    if not Success then

        self:Log(
            "ERROR",
            tostring(Result)
        )

        return false, Result
    end

    return true, Result
end

--==============================================================
-- LOG SYSTEM
--==============================================================

function COS:Log(Category, Message)

    if not self.Config.Debug.Enabled then
        return
    end

    local Entry = {

        Category = tostring(Category),

        Message = tostring(Message),

        Timestamp = os.date("%H:%M:%S"),

        Clock = self:Now(),

    }

    table.insert(self.Data.Logs, Entry)

    while #self.Data.Logs >
        self.Config.Debug.MaximumLogs do

        table.remove(self.Data.Logs, 1)

    end

    if self.Config.General.DebugMode then

        print(string.format(
            "[COS][%s] %s",
            Entry.Category,
            Entry.Message
        ))

    end

end

--==============================================================
-- CHARACTER MANAGEMENT
--==============================================================

function COS:UpdateCharacter()

    local Character = LocalPlayer.Character

    if not Character then

        self.State.CurrentCharacter = nil
        self.State.CurrentHumanoid = nil
        self.State.CurrentRootPart = nil

        return false
    end

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    local RootPart =
        Character:FindFirstChild("HumanoidRootPart")

    self.State.CurrentCharacter = Character
    self.State.CurrentHumanoid = Humanoid
    self.State.CurrentRootPart = RootPart

    return Humanoid ~= nil and RootPart ~= nil
end

function COS:GetCharacter()

    return self.State.CurrentCharacter
end

function COS:GetHumanoid()

    return self.State.CurrentHumanoid
end

function COS:GetRootPart()

    return self.State.CurrentRootPart
end

--==============================================================
-- PLAYER INFORMATION
--==============================================================

function COS:GetPlayerInformation(Player)

    if not Player then
        return nil
    end

    return {

        Name = Player.Name,

        DisplayName = Player.DisplayName,

        UserId = Player.UserId,

        IsLocalPlayer = Player == LocalPlayer,

    }
end

--==============================================================
-- MEMORY STORAGE
--==============================================================

function COS:AddMemory(Category, Information)

    if not self.Config.Memory.Enabled then
        return
    end

    local Entry = {

        Category = tostring(Category),

        Information = Information,

        Timestamp = os.date("%Y-%m-%d %H:%M:%S"),

        Clock = self:Now(),

    }

    table.insert(self.Data.Experiences, Entry)

    while #self.Data.Experiences >
        self.Config.Memory.MaximumEntries do

        table.remove(self.Data.Experiences, 1)

    end

end

--==============================================================
-- MESSAGE DUPLICATION CONTROL
--==============================================================

function COS:HasProcessedMessage(MessageId)

    if not MessageId then
        return false
    end

    return self.Data.ProcessedMessages[
        tostring(MessageId)
    ] == true

end

function COS:MarkMessageProcessed(MessageId)

    if not MessageId then
        return
    end

    self.Data.ProcessedMessages[
        tostring(MessageId)
    ] = true

end

--==============================================================
-- COOLDOWN FOUNDATION
--==============================================================

function COS:GetRemainingCooldown()

    if not self.Config.Cooldown.Enabled then
        return 0
    end

    return math.max(
        0,
        self.State.CooldownEndsAt - self:Now()
    )

end

function COS:IsCoolingDown()

    return self:GetRemainingCooldown() > 0

end

function COS:StartCooldown()

    if not self.Config.Cooldown.Enabled then
        return
    end

    self.State.CooldownEndsAt =
        self:Now() + self.Config.Cooldown.Duration

    self.State.IsOnCooldown = true

    self:Log(
        "COOLDOWN",
        "Cooldown iniciado."
    )

end

function COS:UpdateCooldown()

    local Remaining = self:GetRemainingCooldown()

    self.State.IsOnCooldown = Remaining > 0

    return Remaining

end

--==============================================================
-- BASIC STATUS
--==============================================================

function COS:GetStatus()

    return {

        Name = self.Name,

        Version = self.Version,

        Running = self.State.Running,

        Connected = self.State.Connected,

        APIAvailable = self.State.APIAvailable,

        IsResearching = self.State.IsResearching,

        IsResponding = self.State.IsResponding,

        IsOnCooldown = self:IsCoolingDown(),

    }

end

--==============================================================
-- INITIALIZATION
--==============================================================

function COS:Initialize()

    if self.State.Initialized then
        return
    end

    self:Log(
        "SYSTEM",
        "Inicializando COS..."
    )

    self:UpdateCharacter()

    self:AddConnection(
        LocalPlayer.CharacterAdded:Connect(function()

            task.wait(0.5)

            self:UpdateCharacter()

            self:Log(
                "CHARACTER",
                "Personagem atualizado."
            )

        end)
    )

    self:AddConnection(
        LocalPlayer.CharacterRemoving:Connect(function()

            self.State.CurrentCharacter = nil
            self.State.CurrentHumanoid = nil
            self.State.CurrentRootPart = nil

        end)
    )

    self.State.Initialized = true

    self:Log(
        "SYSTEM",
        "Estrutura principal carregada."
    )

end

