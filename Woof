--==============================================================
-- MESSAGE NORMALIZATION
--==============================================================

function COS:NormalizeChatMessage(Message)

    if typeof(Message) ~= "string" then
        return ""
    end

    Message = self:Normalize(Message)

    Message = Message:gsub("[%c]", " ")
    Message = Message:gsub("%s+", " ")

    return self:Trim(Message)
end

--==============================================================
-- QUESTION DETECTION
--==============================================================

function COS:IsQuestion(Message)

    if typeof(Message) ~= "string" then
        return false
    end

    local Text = self:NormalizeChatMessage(Message)

    if Text:find("%?") then
        return true
    end

    local Keywords = {
        "quem",
        "qual",
        "quando",
        "onde",
        "como",
        "porque",
        "por que",
        "quanto",
        "quantos",
        "quantas",
        "pode",
        "posso",
        "consegue",
        "sabe",
        "será",
        "é verdade",
    }

    for _, Keyword in ipairs(Keywords) do

        if Text:match("^" .. Keyword .. "%f[%W]")
            or Text:find(" " .. Keyword .. "%f[%W]") then

            return true

        end
    end

    return false
end

--==============================================================
-- COS MENTION DETECTION
--==============================================================

function COS:IsMentioned(Message)

    local Text = self:NormalizeChatMessage(Message)

    local Names = {
        "cos",
        "chatgptoss",
    }

    for _, Name in ipairs(Names) do

        if Text:find(Name, 1, true) then
            return true
        end

    end

    return false
end

--==============================================================
-- AUTOMATIC RESPONSES
--==============================================================

function COS:GetAutomaticResponse(Message)

    if not self.Config.AutomaticResponses.Enabled then
        return nil
    end

    local Text = self:NormalizeChatMessage(Message)

    local Categories = {
        "Greetings",
        "Identity",
        "Basic",
    }

    for _, Category in ipairs(Categories) do

        if not self.Config.AutomaticResponses[Category] then
            continue
        end

        local Patterns =
            self.Data.AutomaticResponsePatterns[Category]

        for _, Entry in ipairs(Patterns) do

            if Text:find(Entry.Pattern) then
                return Entry.Response
            end

        end
    end

    return nil
end

--==============================================================
-- DUPLICATE MESSAGE CONTROL
--==============================================================

function COS:ProcessChatMessageId(MessageId)

    if not self.Config.Chat.IgnoreDuplicates then
        return true
    end

    if not MessageId then
        return true
    end

    if self:HasProcessedMessage(MessageId) then
        return false
    end

    self:MarkMessageProcessed(MessageId)

    return true
end

--==============================================================
-- RESPONSE DELIVERY
--==============================================================

function COS:SetChatResponseHandler(Handler)

    if typeof(Handler) ~= "function" then
        self.Chat.ResponseHandler = nil
        return false
    end

    self.Chat.ResponseHandler = Handler

    self:Log(
        "CHAT",
        "Manipulador autorizado de respostas configurado."
    )

    return true
end

function COS:DeliverChatResponse(Message)

    if typeof(Message) ~= "string" then
        return false
    end

    Message = self:Trim(Message)

    if Message == "" then
        return false
    end

    local Maximum =
        self.Config.Chat.MaximumMessageLength

    if #Message > Maximum then
        Message = string.sub(Message, 1, Maximum)
    end

    local Handler = self.Chat.ResponseHandler

    if not Handler then

        self:Log(
            "CHAT",
            "Resposta preparada, mas nenhum manipulador autorizado foi configurado."
        )

        return false
    end

    local Success, Result = pcall(
        Handler,
        Message
    )

    if not Success then

        self:Log(
            "CHAT_ERROR",
            tostring(Result)
        )

        return false
    end

    self.State.MessagesSent += 1

    self.State.LastResponse = Message

    self:Log(
        "CHAT",
        "Resposta entregue ao manipulador."
    )

    return true
end

