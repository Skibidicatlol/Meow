--========================================================--
-- OCULTAÇÃO DOS OBJETOS DO NPC
--========================================================--

S.EnforceNPCObjectHidden = function(state, object)
    if not state or not object then
        return
    end

    if object:IsA("BasePart") then
        object.LocalTransparencyModifier = 1

    elseif object:IsA("Decal")
        or object:IsA("Texture") then

        object.Transparency = 1
    end
end

S.MonitorNPCObject = function(state, object)
    if not state or not object then
        return
    end

    state.MonitoredObjects = state.MonitoredObjects or {}

    if state.MonitoredObjects[object] then
        return
    end

    state.MonitoredObjects[object] = true

    S.EnforceNPCObjectHidden(state, object)
end

S.HideNPCOriginal = function(state)
    if not state or not state.Source then
        return
    end

    state.OriginalVisibility = {}
    state.MonitoredObjects = {}

    for _, object in ipairs(state.Source:GetDescendants()) do

        if object:IsA("BasePart") then

            state.OriginalVisibility[object] = {
                LocalTransparencyModifier =
                    object.LocalTransparencyModifier
            }

            S.MonitorNPCObject(state, object)

        elseif object:IsA("Decal")
            or object:IsA("Texture") then

            state.OriginalVisibility[object] = {
                Transparency = object.Transparency
            }

            S.MonitorNPCObject(state, object)
        end
    end
end

S.EnforceNPCOriginalHidden = function(state)
    if not state or not state.Source then
        return
    end

    for object in pairs(state.MonitoredObjects or {}) do

        if object and object.Parent then
            S.EnforceNPCObjectHidden(state, object)
        end
    end
end

S.RestoreNPCOriginal = function(state)
    if not state then
        return
    end

    for object, properties in pairs(
        state.OriginalVisibility or {}
    ) do

        if object and object.Parent then

            if object:IsA("BasePart") then

                object.LocalTransparencyModifier =
                    properties.LocalTransparencyModifier or 0

            elseif object:IsA("Decal")
                or object:IsA("Texture") then

                object.Transparency =
                    properties.Transparency or 0
            end
        end
    end

    state.OriginalVisibility = {}
    state.MonitoredObjects = {}
end

--========================================================--
-- CONEXÕES DO NPC
--========================================================--

S.DisconnectNPCState = function(state)
    if not state then
        return
    end

    S.DisconnectAll(state.Connections)
end

--========================================================--
-- DESTRUIÇÃO DO ESTADO DO NPC
--========================================================--

S.DestroyNPCState = function(model)
    local state = S.NPCStates[model]

    if not state then
        return
    end

    state.Active = false

    S.DisconnectNPCState(state)

    S.RestoreNPCOriginal(state)

    if state.Rig then
        S.GeneratedRigs[state.Rig] = nil

        pcall(function()
            state.Rig:Destroy()
        end)
    end

    S.NPCStates[model] = nil
end

--========================================================--
-- PREPARAÇÃO DO RIG DO NPC
--========================================================--

S.PrepareNPCRig = function(state)
    if not state
        or not state.Source
        or not state.Rig then
        return false
    end

    state.Active = false

    state.PartPairs = {}
    state.AccessoryData = {}

    -- Os NPCs continuam usando WeldConstraint.
    S.CaptureAccessories(state)

    S.BuildIndividualWelds(state)

    local partCount = 0

    for _, pair in pairs(state.PartPairs) do
        if pair.Source
            and pair.Target then
            partCount += 1
        end
    end

    if partCount == 0 then
        warn(
            "[R6System] Nenhuma peça correspondente encontrada:",
            state.Source:GetFullName()
        )

        return false
    end

    state.Active = true

    S.UpdatePartSizes(state)
    S.UpdateAccessories(state)

    S.HideNPCOriginal(state)

    return true
end

--========================================================--
-- CONFIGURAÇÃO DO NPC
--========================================================--

S.SetupNPC = function(model)
    if not S.RUNNING then
        return
    end

    if S.IsExcluded(model) then
        return
    end

    if S.NPCStates[model] then
        return
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    local sourceRoot = S.FindNPCSourcePart(model)

    if not sourceRoot then
        return
    end

    local rig, rigHumanoid, rigRoot = S.CreateR6(model)

    if not rig then
        return
    end

    local state = {
        Source = model,

        SourceHumanoid = humanoid,
        SourceRoot = sourceRoot,

        Rig = rig,
        RigHumanoid = rigHumanoid,
        RigRoot = rigRoot,

        Active = false,

        Connections = {},
        PartPairs = {},

        AccessoryData = {},
        OriginalVisibility = {},
        MonitoredObjects = {},
        SizeMonitored = {},
    }

    S.NPCStates[model] = state

    local success, result = pcall(function()
        return S.PrepareNPCRig(state)
    end)

    if not success or not result then
        warn(
            "[R6System] Falha ao preparar NPC:",
            model.Name,
            result
        )

        S.DestroyNPCState(model)
        return
    end

    -- Remove o rig se o NPC original for removido.
    S.Connect(
        state.Connections,

        model.AncestryChanged:Connect(function(_, parent)
            if not parent then
                S.DestroyNPCState(model)
            end
        end)
    )

    -- Limpa o estado quando o Humanoid desaparecer.
    S.Connect(
        state.Connections,

        humanoid.AncestryChanged:Connect(function(_, parent)
            if not parent then
                S.DestroyNPCState(model)
            end
        end)
    )
end

