function COS:ScanEnvironment()

    if not self.Config.Perception.Enabled then
        return false
    end

    if self.Perception.IsScanning then
        return false
    end

    self.Perception.IsScanning = true

    local Success, ErrorMessage = pcall(function()

        self:ObserveOwnCharacter()
        self:ObservePlayers()
        self:ObserveObjects()
        self:ObserveStructures()
        self:ObserveDisasters()

        self.Data.Environment.LastScan = self:Now()

        self.Perception.LastScan = self:Now()

    end)

    self.Perception.IsScanning = false

    if not Success then

        self:Log(
            "PERCEPTION_ERROR",
            tostring(ErrorMessage)
        )

        return false
    end

    return true
end

