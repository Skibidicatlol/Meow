S.RemoveInternalMotor6Ds = function(rig)
    if not rig then
        return
    end

    for _, object in ipairs(rig:GetDescendants()) do
        if object:IsA("Motor6D") then
            object:Destroy()
        end
    end
end

--========================================================--
-- CRIAÇÃO DOS WELDS
--========================================================--

S.CreateNPCPartWeld = function(
    state,
    sourcePart,
    targetPart
)
    if not state or not sourcePart or not targetPart then
        return
    end

    if not sourcePart:IsA("BasePart")
        or not targetPart:IsA("BasePart") then
        return
    end

    state.PartPairs = state.PartPairs or {}

    local key = targetPart.Name

    if state.PartPairs[key]
        and state.PartPairs[key].Weld then

        state.PartPairs[key].Weld:Destroy()
    end

    targetPart.CFrame = sourcePart.CFrame

    -- Mantém a desancoragem necessária para o weld.
    targetPart.Anchored = false

    local weld = Instance.new("WeldConstraint")

    weld.Name = "R6_Follow_" .. key
    weld.Part0 = sourcePart
    weld.Part1 = targetPart
    weld.Parent = targetPart

    state.PartPairs[key] = {
        Source = sourcePart,
        Target = targetPart,
        Weld = weld,

        OriginalSourceSize =
            S.GetEffectivePartSize(sourcePart),

        OriginalTargetSize = targetPart.Size,
    }
end

--========================================================--
-- WELDS INDIVIDUAIS
-- USADO PELOS NPCs E PELO MODO ANIMATED
--========================================================--

S.BuildIndividualWelds = function(state)
    if not state or not state.Source or not state.Rig then
        return
    end

    state.PartPairs = {}

    S.RemoveInternalMotor6Ds(state.Rig)

    for _, targetPart in ipairs(state.Rig:GetChildren()) do

        if targetPart:IsA("BasePart") then

            local sourcePart = S.FindNPCSourcePart(
                state.Source,
                targetPart.Name
            )

            if sourcePart then
                S.CreateNPCPartWeld(
                    state,
                    sourcePart,
                    targetPart
                )
            end
        end
    end
end

--========================================================--
-- PARES DO CLASSIC
-- PRESERVA OS MOTOR6D
--========================================================--

S.BuildClassicPartPairs = function(state)
    if not state or not state.Source or not state.Rig then
        return
    end

    state.PartPairs = {}

    -- Não remove Motor6D.
    -- Não cria WeldConstraint.
    -- Preserva as articulações originais do R6.

    for _, targetPart in ipairs(state.Rig:GetChildren()) do

        if targetPart:IsA("BasePart") then

            local sourcePart = S.FindNPCSourcePart(
                state.Source,
                targetPart.Name
            )

            if sourcePart then

                state.PartPairs[targetPart.Name] = {
                    Source = sourcePart,
                    Target = targetPart,

                    OriginalSourceSize =
                        S.GetEffectivePartSize(sourcePart),

                    OriginalTargetSize = targetPart.Size,
                }
            end
        end
    end
end

--========================================================--
-- ATUALIZAÇÃO DE TAMANHO
--========================================================--

S.UpdatePartSizes = function(state)
    if not state
        or not state.Active
        or not state.PartPairs then
        return
    end

    if not S.CONFIG.AUTO_SIZE then
        return
    end

    for _, pair in pairs(state.PartPairs) do

        local source = pair.Source
        local target = pair.Target

        if source
            and target
            and source.Parent
            and target.Parent then

            local currentSize =
                S.GetEffectivePartSize(source)

            local ratio = S.GetScaleRatio(
                pair.OriginalSourceSize,
                currentSize
            )

            local newSize = S.ScaleVector(
                pair.OriginalTargetSize,
                ratio
            )

            if (target.Size - newSize).Magnitude > 0.001 then
                target.Size = newSize
            end
        end
    end
end

--========================================================--
-- ACESSÓRIOS
--========================================================--

S.FindAccessoryBodyPart = function(state, accessory)
    if not state or not state.Rig then
        return nil
    end

    local handle = accessory:FindFirstChild("Handle")

    if not handle then
        return nil
    end

    local attachment =
        handle:FindFirstChildWhichIsA("Attachment")

    if attachment then

        for _, bodyPart in ipairs(state.Rig:GetChildren()) do

            if bodyPart:IsA("BasePart") then

                local matching =
                    bodyPart:FindFirstChild(attachment.Name)

                if matching
                    and matching:IsA("Attachment") then
                    return bodyPart
                end
            end
        end
    end

    return nil
end

S.CaptureAccessories = function(state)
    if not state then
        return
    end

    state.AccessoryData = {}

    if not state.Rig then
        return
    end

    for _, accessory in ipairs(state.Rig:GetChildren()) do

        if accessory:IsA("Accessory") then

            local handle = accessory:FindFirstChild("Handle")

            local bodyPart =
                S.FindAccessoryBodyPart(state, accessory)

            if handle
                and handle:IsA("BasePart")
                and bodyPart then

                local data = {
                    Accessory = accessory,
                    Handle = handle,
                    BodyPart = bodyPart,

                    OriginalHandleSize = handle.Size,
                    OriginalBodySize = bodyPart.Size,

                    Attachments = {},
                    Welds = {},
                }

                for _, object in ipairs(
                    accessory:GetDescendants()
                ) do

                    if object:IsA("Attachment") then

                        data.Attachments[object] = {
                            CFrame = object.CFrame,
                            OnHandle = object:IsDescendantOf(handle),
                        }

                    elseif object:IsA("Weld") then

                        data.Welds[object] = {
                            C0 = object.C0,
                            C1 = object.C1,
                        }
                    end
                end

                table.insert(state.AccessoryData, data)
            end
        end
    end
end

S.UpdateAccessories = function(state)
    if not state or not state.Active then
        return
    end

    for _, data in ipairs(state.AccessoryData or {}) do

        local handle = data.Handle
        local body = data.BodyPart

        if handle
            and handle.Parent
            and body
            and body.Parent then

            local bodyRatio = S.ClampAccessoryScale(
                S.GetScaleRatio(
                    data.OriginalBodySize,
                    body.Size
                )
            )

            local newHandleSize = S.ScaleVector(
                data.OriginalHandleSize,
                bodyRatio
            )

            local handleRatio = S.ClampAccessoryScale(
                S.GetScaleRatio(
                    data.OriginalHandleSize,
                    newHandleSize
                )
            )

            if (handle.Size - newHandleSize).Magnitude > 0.001 then
                handle.Size = newHandleSize
            end

            for attachment, info in pairs(data.Attachments) do

                if attachment and attachment.Parent then

                    local ratio = info.OnHandle
                        and handleRatio
                        or bodyRatio

                    attachment.CFrame =
                        S.ScaleCFrameOffset(
                            info.CFrame,
                            ratio
                        )
                end
            end

            for weld, info in pairs(data.Welds) do

                if weld and weld.Parent then

                    weld.C0 = S.ScaleCFrameOffset(
                        info.C0,
                        handleRatio
                    )

                    weld.C1 = S.ScaleCFrameOffset(
                        info.C1,
                        bodyRatio
                    )
                end
            end
        end
    end
end

