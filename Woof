    end

    local Information = {
        Name = Character.Name,
        Position = RootPart.Position,
        Health = Humanoid.Health,
        MaxHealth = Humanoid.MaxHealth,
        HealthPercent = 0,
        WalkSpeed = Humanoid.WalkSpeed,
        JumpPower = Humanoid.JumpPower,
        MoveDirection = Humanoid.MoveDirection,
        IsMoving = Humanoid.MoveDirection.Magnitude > 0.05,
        FloorMaterial = tostring(Humanoid.FloorMaterial),
        State = tostring(Humanoid:GetState()),
    }

    if Humanoid.MaxHealth > 0 then
        Information.HealthPercent =
            Humanoid.Health / Humanoid.MaxHealth * 100
    end

    self.Data.Environment.OwnCharacter = Information

    return Information
end

--==============================================================
-- PLAYER OBSERVATION
--==============================================================

function COS:ObservePlayers()

    if not self.Config.Perception.ObservePlayers then
        return {}
    end

    local RootPart = self:GetRootPart()

    if not RootPart then
        return {}
    end

    local Results = {}

    for _, Player in ipairs(Players:GetPlayers()) do

        if Player == LocalPlayer then
            continue
        end

        local Character = Player.Character

        if not Character then
            continue
        end

        local Humanoid =
            Character:FindFirstChildOfClass("Humanoid")

        local PlayerRoot =
            Character:FindFirstChild("HumanoidRootPart")

        if not PlayerRoot then
            continue
        end

        local Distance = self:GetDistance(
            RootPart.Position,
            PlayerRoot.Position
        )

        if Distance > self.Config.Perception.ObservationRadius then
            continue
        end

        table.insert(Results, {
            Name = Player.Name,
            DisplayName = Player.DisplayName,
            UserId = Player.UserId,
            Position = PlayerRoot.Position,
            Distance = Distance,
            Health = Humanoid and Humanoid.Health or nil,
            MaxHealth = Humanoid and Humanoid.MaxHealth or nil,
            IsAlive = Humanoid ~= nil
                and Humanoid.Health > 0,
        })

    end

    self.Data.Environment.Players = Results

    self.Data.Players = Results

    return Results
end

--==============================================================
-- OBJECT OBSERVATION
--==============================================================

function COS:ObserveObjects()

    if not self.Config.Perception.ObserveObjects then
        return {}
    end

    local RootPart = self:GetRootPart()

    if not RootPart then
        return {}
    end

    local Results = {}

    local Radius =
        self.Config.Perception.ObservationRadius

    for _, Object in ipairs(
        Workspace:GetDescendants()
    ) do

        if not Object:IsA("BasePart") then
            continue
        end

        if Object.Parent == nil then
            continue
        end

        local Distance = self:GetDistance(
            RootPart.Position,
            Object.Position
        )

        if Distance > Radius then
            continue
        end

        if #Results >= 150 then
            break
        end

        table.insert(Results, {
            Name = Object.Name,
            ClassName = Object.ClassName,
            Position = Object.Position,
            Distance = Distance,
            Size = Object.Size,
            Anchored = Object.Anchored,
            CanCollide = Object.CanCollide,
            Material = tostring(Object.Material),
            Transparency = Object.Transparency,
        })

    end

    self.Data.Environment.Objects = Results

    return Results
end

--==============================================================
-- STRUCTURE OBSERVATION
--==============================================================

function COS:ObserveStructures()

    if not self.Config.Perception.ObserveStructures then
        return {}
    end

    local RootPart = self:GetRootPart()

    if not RootPart then
        return {}
    end

    local Results = {}

    for _, Object in ipairs(
        Workspace:GetChildren()
    ) do

        if not Object:IsA("Model") then
            continue
        end

        local Success, Pivot = pcall(function()
            return Object:GetPivot()
        end)

        if not Success then
            continue
        end

        local Distance = self:GetDistance(
            RootPart.Position,
            Pivot.Position
        )

        if Distance > self.Config.Perception.ObservationRadius then
            continue
        end

        table.insert(Results, {
            Name = Object.Name,
            Position = Pivot.Position,
            Distance = Distance,
            PartCount = #Object:GetDescendants(),
        })

    end

    self.Data.Environment.Structures = Results

    return Results
end

--==============================================================
-- DISASTER OBSERVATION
--==============================================================

function COS:ObserveDisasters()

    if not self.Config.Perception.ObserveDisasters then
        return {}
    end

    local Results = {}

    -- Somente nomes de objetos e atributos
    -- replicados e visíveis ao cliente.

    local PossibleNames = {
        "Tornado",
        "Earthquake",
        "Flood",
        "Tsunami",
        "Volcano",
        "Meteor",
        "Blizzard",
        "Sandstorm",
        "Fire",
        "AcidRain",
    }

    local SearchRoots = {
        Workspace,
    }

    for _, Root in ipairs(SearchRoots) do

        for _, Object in ipairs(
            Root:GetDescendants()
        ) do

            local Name = string.lower(Object.Name)

            for _, DisasterName in ipairs(PossibleNames) do

                if Name:find(
                    string.lower(DisasterName),
                    1,
                    true
                ) then

                    table.insert(Results, {
                        Name = DisasterName,
                        ObjectName = Object.Name,
                        ClassName = Object.ClassName,
                    })

                    break
                end

            end

            if #Results >= 30 then
                break
            end

        end

    end

    self.Data.Environment.Disasters = Results

    if #Results > 0 then

        self.State.CurrentDisaster =
            Results[1].Name

    else

        self.State.CurrentDisaster = nil

    end

    return Results
end

