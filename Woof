function COS:RememberConversation(Sender, Message, Response)

    if not self.Config.Memory.Enabled then
        return false
    end

    if not self.Config.Memory.RememberConversations then
        return false
    end

    local Entry = {
        Sender = tostring(Sender or "Unknown"),
        Message = tostring(Message or ""),
        Response = tostring(Response or ""),
        Timestamp = os.date("%H:%M:%S"),
        Clock = self:Now(),
    }

    table.insert(self.Data.Conversations, Entry)

    while #self.Data.Conversations >
        self.Config.Memory.MaximumEntries do

        table.remove(self.Data.Conversations, 1)

    end

    self.Data.Statistics.TotalMemories += 1

    return true
end

function COS:GetRecentMemories(Amount)

    Amount = math.clamp(
        tonumber(Amount) or 10,
        1,
        50
    )

    local Results = {}

    local StartIndex = math.max(
        1,
        #self.Data.Experiences - Amount + 1
    )

    for Index = StartIndex, #self.Data.Experiences do

        table.insert(
            Results,
            self.Data.Experiences[Index]
        )

    end

    return Results
end

function COS:ClearSessionMemory()

    table.clear(self.Data.Experiences)
    table.clear(self.Data.Conversations)

    self.Data.Statistics.TotalMemories = 0

    self:Log(
        "MEMORY",
        "Memória da sessão limpa."
