}

--==============================================================
-- DECISION STORAGE
--==============================================================

COS.Decision.History = {}
COS.Decision.MaximumHistory = 100

function COS:AddDecision(Category, Description, Priority)

    local Entry = {
        Category = tostring(Category),
        Description = tostring(Description),
        Priority = Priority or 0,
        Timestamp = os.date("%H:%M:%S"),
        Clock = self:Now(),
    }

    table.insert(
        self.Decision.History,
        Entry
    )

    while #self.Decision.History >
        self.Decision.MaximumHistory do

        table.remove(
            self.Decision.History,
            1
        )

    end

    self.Decision.LastDecision = Entry

    self:Log(
        "DECISION",
        Entry.Category .. ": " .. Entry.Description
    )

    return Entry
end

--==============================================================
-- HEALTH EVALUATION
--==============================================================

function COS:EvaluateHealth()

    local Humanoid = self:GetHumanoid()

    if not Humanoid then
        return "UNKNOWN", 0
    end

    if Humanoid.Health <= 0 then
        return "DEAD", 100
    end

    local Percentage = 100

    if Humanoid.MaxHealth > 0 then

        Percentage =
            Humanoid.Health / Humanoid.MaxHealth * 100

    end

    if Percentage <= 20 then
        return "CRITICAL", 100
    elseif Percentage <= 45 then
        return "LOW", 75
    elseif Percentage <= 75 then
        return "MEDIUM", 40
    end

    return "HEALTHY", 0
end

--==============================================================
-- ENVIRONMENT RISK EVALUATION
--==============================================================

function COS:EvaluateEnvironmentRisk()

    local Risk = 0
    local Reasons = {}

    local Environment = self.Data.Environment

    if not Environment then
        return Risk, Reasons
    end

    local HealthState, HealthRisk =
        self:EvaluateHealth()

    Risk += HealthRisk

    if HealthState == "CRITICAL" then

        table.insert(
            Reasons,
            "Saúde em estado crítico."
        )

    elseif HealthState == "LOW" then

        table.insert(
            Reasons,
            "Saúde abaixo do nível recomendado."
        )

    end

    local Humanoid = self:GetHumanoid()

    if Humanoid then

        if Humanoid.FloorMaterial ==
            Enum.Material.Air then

            Risk += 10

            table.insert(
                Reasons,
                "Personagem sem contato com o chão."
            )

        end

        if Humanoid:GetState() ==
            Enum.HumanoidStateType.FallingDown then

            Risk += 20

            table.insert(
                Reasons,
                "Personagem perdeu o equilíbrio."
            )

        end

    end

    if self.State.CurrentDisaster then

        Risk += 25

        table.insert(
            Reasons,
            "Possível desastre identificado: " ..
            tostring(self.State.CurrentDisaster)
        )

    end

    Risk = math.clamp(Risk, 0, 100)

    return Risk, Reasons
end

--==============================================================
-- PLAYER DISTANCE ANALYSIS
--==============================================================

function COS:GetNearestPlayer()

    local PlayersData =
        self.Data.Environment.Players

    local Nearest = nil
    local MinimumDistance = math.huge

    for _, PlayerData in ipairs(PlayersData) do

        if PlayerData.Distance < MinimumDistance then

            MinimumDistance = PlayerData.Distance
            Nearest = PlayerData

        end

    end

    return Nearest, MinimumDistance
end

--==============================================================
-- SAFE POSITION CHECK
--==============================================================

function COS:IsPositionAvailable(Position)

    if typeof(Position) ~= "Vector3" then
        return false
    end

    local Character = self:GetCharacter()

    if not Character then
        return false
    end

    local Parameters = RaycastParams.new()

    Parameters.FilterType =
        Enum.RaycastFilterType.Exclude

    Parameters.FilterDescendantsInstances = {
        Character
    }

    local Origin = Position + Vector3.new(0, 4, 0)

    local Result = Workspace:Raycast(
        Origin,
        Vector3.new(0, -10, 0),
        Parameters
    )

    if not Result then
        return false
    end

    if Result.Instance.CanCollide == false then
        return false
    end

    return true
end

--==============================================================
-- OBJECTIVE SELECTION
--==============================================================

function COS:SelectMovementObjective()

    local RootPart = self:GetRootPart()

    if not RootPart then
        return nil, "Personagem indisponível."
    end

    local Risk, Reasons =
        self:EvaluateEnvironmentRisk()

    local HealthState =
        self:EvaluateHealth()

    if HealthState == "DEAD" then

        return nil, "Personagem está morto."

    end

    -- Sem informações confiáveis sobre o desastre,
    -- o COS não escolhe uma rota automática.

    if self.State.CurrentDisaster then

        return nil,
            "Aguardando informações confiáveis sobre o ambiente."

    end

    if Risk >= 75 then

        return nil,
            "Risco elevado. Movimento automático suspenso."

    end

    return nil,
        "Nenhum objetivo seguro identificado."
end

--==============================================================
-- DECISION ENGINE
--==============================================================

function COS:Think()

    if self.Decision.IsThinking then
        return nil
    end

    self.Decision.IsThinking = true

    local Success, Result = pcall(function()

        local Risk, Reasons =
            self:EvaluateEnvironmentRisk()

        local HealthState =
            self:EvaluateHealth()

        local Objective, ObjectiveReason =
            self:SelectMovementObjective()

        local Decision = {
            Risk = Risk,
            HealthState = HealthState,
            Reasons = Reasons,
            Objective = Objective,
            ObjectiveReason = ObjectiveReason,
            Timestamp = self:Now(),
        }

        if HealthState == "DEAD" then

            self:AddDecision(
                "HEALTH",
                "Personagem indisponível.",
                self.Decision.Priority.Critical
            )

        elseif Risk >= 75 then

            self:AddDecision(
                "SAFETY",
                "Movimentação automática suspensa.",
                self.Decision.Priority.High
            )

        else

            self:AddDecision(
                "ANALYSIS",
                ObjectiveReason,
                self.Decision.Priority.Low
            )

        end

        self.Decision.LastEvaluation =
            self:Now()

        return Decision

    end)

    self.Decision.IsThinking = false

    if not Success then

        self:Log(
            "DECISION_ERROR",
            tostring(Result)
        )

        return nil
    end

    return Result
end

