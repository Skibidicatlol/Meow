--========================================================--
-- CONEXÕES
--========================================================--

S.Connect = function(list, connection)
    if not list or not connection then
        return connection
    end

    table.insert(list, connection)

    return connection
end

S.DisconnectAll = function(list)
    if not list then
        return
    end

    for _, connection in ipairs(list) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(list)
end

--========================================================--
-- IDENTIFICAÇÃO
--========================================================--

S.IsGenerated = function(model)
    return model and (
        S.GeneratedRigs[model] == true
        or model:GetAttribute("R6ReplacementTag") == S.TAG
    )
end

S.IsPlayerCharacter = function(model)
    if not model then
        return false
    end

    for _, player in ipairs(S.Players:GetPlayers()) do
        local character = player.Character

        if character and (
            model == character
            or model:IsDescendantOf(character)
        ) then
            return true
        end
    end

    return false
end

--========================================================--
-- FILTRO DE NPCs
--========================================================--

S.IsInsideIgnoredFolder = function(object)
    if not object then
        return false
    end

    local current = object

    while current and current ~= S.Workspace do

        if current.Name == "Players"
            and current.Parent == S.Workspace then
            return true
        end

        if current.Name == "Lobby"
            or current.Name == "POIs" then

            local parent = current.Parent

            if parent
                and parent.Name == "Map"
                and parent.Parent == S.Workspace then
                return true
            end
        end

        current = current.Parent
    end

    return false
end

S.CanRunNPCSystem = function()
    return S.Workspace:FindFirstChild("Players") ~= nil
        and S.Workspace:FindFirstChild("Map") ~= nil
end

S.IsExcluded = function(model)
    return not model
        or not model:IsA("Model")
        or not model.Parent
        or S.IsGenerated(model)
        or S.IsPlayerCharacter(model)
        or S.IsInsideIgnoredFolder(model)
end

--========================================================--
-- ESCALA
--========================================================--

S.GetScaleRatio = function(originalSize, currentSize)
    return Vector3.new(
        currentSize.X / math.max(originalSize.X, 0.001),
        currentSize.Y / math.max(originalSize.Y, 0.001),
        currentSize.Z / math.max(originalSize.Z, 0.001)
    )
end

S.ScaleVector = function(vector, ratio)
    return Vector3.new(
        vector.X * ratio.X,
        vector.Y * ratio.Y,
        vector.Z * ratio.Z
    )
end

S.ScaleCFrameOffset = function(offset, ratio)
    local position = offset.Position
    local rotation = offset - position

    return CFrame.new(
        S.ScaleVector(position, ratio)
    ) * rotation
end

S.ClampAccessoryScale = function(ratio)
    return Vector3.new(
        math.clamp(
            ratio.X,
            S.CONFIG.MINIMUM_ACCESSORY_SCALE,
            S.CONFIG.MAXIMUM_ACCESSORY_SCALE
        ),

        math.clamp(
            ratio.Y,
            S.CONFIG.MINIMUM_ACCESSORY_SCALE,
            S.CONFIG.MAXIMUM_ACCESSORY_SCALE
        ),

        math.clamp(
            ratio.Z,
            S.CONFIG.MINIMUM_ACCESSORY_SCALE,
            S.CONFIG.MAXIMUM_ACCESSORY_SCALE
        )
    )
end

--========================================================--
-- TAMANHO VISUAL EFETIVO
--========================================================--

S.GetEffectivePartSize = function(part)
    if not part or not part:IsA("BasePart") then
        return Vector3.one
    end

    local size = part.Size
    local mesh = part:FindFirstChildOfClass("SpecialMesh")

    if mesh then
        size = Vector3.new(
            size.X * math.abs(mesh.Scale.X),
            size.Y * math.abs(mesh.Scale.Y),
            size.Z * math.abs(mesh.Scale.Z)
        )
    end

    return size
end

