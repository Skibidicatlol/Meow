S.Minimized = false

S.SetMinimized = function(value)
    if not S.Main or not S.Main.Parent then
        return
    end

    S.Minimized = value

    if value then

        for _, child in ipairs(S.Main:GetChildren()) do

            if child ~= header
                and not child:IsA("UICorner")
                and not child:IsA("UIStroke") then

                child.Visible = false
            end
        end

        main.Size = UDim2.fromOffset(310, 42)

        minimizeButton.Text = "+"

    else

        for _, child in ipairs(S.Main:GetChildren()) do

            if child ~= header
                and not child:IsA("UICorner")
                and not child:IsA("UIStroke") then

                child.Visible = true
            end
        end

        main.Size = UDim2.fromOffset(310, 205)

        minimizeButton.Text = "−"
    end
end

minimizeButton.Activated:Connect(function()
    S.SetMinimized(not S.Minimized)
end)

