--// R6 AVATAR + NPCs
--// PARTE E/5 — LAST SURVIVOR, RESPAWN E INICIALIZAÇÃO
--//====================================================

local S = ((getgenv and getgenv()) or _G).R6System

assert(S, "Execute a Parte A antes da Parte E.")

--//====================================================
--// CONFIGURAÇÕES DA MÚSICA
--//====================================================

S.LAST_SURVIVOR_URL = S.LAST_SURVIVOR_URL
    or "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3"

S.LAST_SURVIVOR_FILE = "R6System_LastSurvivor.mp3"
S.LAST_SURVIVOR_VOLUME = 0.7
S.LAST_SURVIVOR_INTERVAL = 1

S.LastSurvivorSound = nil
S.LastSurvivorAsset = nil
S.LastSurvivorDownloaded = false
S.LastSurvivorDownloading = false
S.LastSurvivorMonitorConnection = nil
S.LastSurvivorLastCheck = 0
S.LastSurvivorGeneration = 0

--//====================================================
--// PASTAS DE TIMES
--//====================================================

S.GetTeamFolders = function()
    local playersFolder = S.Workspace:FindFirstChild("Players")

    if not playersFolder then
        return nil, nil
    end

    return playersFolder:FindFirstChild("Killers"),
        playersFolder:FindFirstChild("Survivors")
end

--//====================================================
--// VERIFICAR SE O JOGADOR É KILLER
--//====================================================

S.IsLocalPlayerKiller = function()
    local killersFolder = S.GetTeamFolders()
    local character = S.LocalPlayer.Character

    if not killersFolder or not character then
        return false
    end

    return character:IsDescendantOf(killersFolder)
end

--//====================================================
--// ENCONTRAR ÚNICO SOBREVIVENTE VIVO
--//====================================================

S.GetSingleAliveSurvivor = function()
    local _, survivorsFolder = S.GetTeamFolders()

    if not survivorsFolder then
        return nil
    end

    local aliveSurvivors = {}

    for _, player in ipairs(S.Players:GetPlayers()) do
        local character = player.Character

        if character and character:IsDescendantOf(survivorsFolder) then
            local humanoid = character:FindFirstChildOfClass("Humanoid")

            if humanoid and humanoid.Health > 0 then
                table.insert(aliveSurvivors, player)
            end
        end
    end

    if #aliveSurvivors == 1 then
        return aliveSurvivors[1]
    end

    return nil
end

--//====================================================
--// CONDIÇÃO LAST SURVIVOR
--//====================================================

S.ShouldPlayLastSurvivorMusic = function()
    if not S.IsLocalPlayerKiller() then
        return false
    end

    return S.GetSingleAliveSurvivor() ~= nil
end

--//====================================================
--// OBTER ARQUIVO DE ÁUDIO
--//====================================================

S.GetLastSurvivorAsset = function()
    if S.LastSurvivorAsset then
        return S.LastSurvivorAsset
    end

    if S.LastSurvivorDownloading then
        return nil
    end

    S.LastSurvivorDownloading = true

    local success, result = pcall(function()
        if not isfile or not writefile or not getcustomasset then
            error("Funções de arquivo/asset não disponíveis.")
        end

        if not isfile(S.LAST_SURVIVOR_FILE) then
            local response = game:HttpGet(S.LAST_SURVIVOR_URL)

            if not response or #response == 0 then
                error("O arquivo de áudio retornou vazio.")
            end

            writefile(S.LAST_SURVIVOR_FILE, response)
        end

        S.LastSurvivorDownloaded = true

        return getcustomasset(S.LAST_SURVIVOR_FILE)
    end)

    S.LastSurvivorDownloading = false

    if success and result then
        S.LastSurvivorAsset = result
        return result
    end

    warn(
        "[R6System] Não foi possível carregar a música Last Survivor:",
        result
    )

    return nil
end

--//====================================================
--// PARAR MÚSICA
--//====================================================

S.StopLastSurvivorMusic = function()
    if S.LastSurvivorSound then
        pcall(function()
            S.LastSurvivorSound:Stop()
            S.LastSurvivorSound:Destroy()
        end)

        S.LastSurvivorSound = nil
    end
end

--//====================================================
--// INICIAR MÚSICA
--//====================================================

S.StartLastSurvivorMusic = function()
    if not S.RUNNING then
        return
    end

    if S.LastSurvivorSound and S.LastSurvivorSound.IsPlaying then
        return
    end

    local asset = S.GetLastSurvivorAsset()

    if not asset or not S.RUNNING then
        return
    end

    -- Evitar duplicação de sons.
    S.StopLastSurvivorMusic()

    local sound = Instance.new("Sound")

    sound.Name = "R6System_LastSurvivor"
    sound.SoundId = asset
    sound.Volume = S.LAST_SURVIVOR_VOLUME
    sound.Looped = true
    sound.Parent = S.SoundService

    S.LastSurvivorSound = sound

    local success, err = pcall(function()
        sound:Play()
    end)

    if not success then
        warn("[R6System] Erro ao iniciar música:", err)

        S.StopLastSurvivorMusic()
    end
end

--//====================================================
--// MONITORAR LAST SURVIVOR
--//====================================================

if S.LastSurvivorMonitorConnection then
    S.LastSurvivorMonitorConnection:Disconnect()
    S.LastSurvivorMonitorConnection = nil
end

S.LastSurvivorLastCheck = 0

S.LastSurvivorMonitorConnection =
    S.RunService.Heartbeat:Connect(function()

        if not S.RUNNING then
            return
        end

        local now = os.clock()

        if now - S.LastSurvivorLastCheck < S.LAST_SURVIVOR_INTERVAL then
            return
        end

        S.LastSurvivorLastCheck = now

        local shouldPlay = false

        local success, result = pcall(function()
            return S.ShouldPlayLastSurvivorMusic()
        end)

        if success then
            shouldPlay = result
        else
            warn("[R6System] Erro ao verificar Last Survivor:", result)
        end

        if shouldPlay then
            if not S.LastSurvivorSound
                and not S.LastSurvivorDownloading then

                -- Carregamento em segundo plano.
                task.spawn(function()
                    if not S.RUNNING then
                        return
                    end

                    S.StartLastSurvivorMusic()
                end)
            end
        else
            S.StopLastSurvivorMusic()
        end
    end)

--//====================================================
--// RESPAWN DO JOGADOR
--//====================================================

S.Connect(
    S.GlobalConnections,

    S.LocalPlayer.CharacterAdded:Connect(function(character)
        if not S.RUNNING then
            return
        end

        task.spawn(function()
            local humanoid = character:WaitForChild("Humanoid", 10)
            local root = character:WaitForChild("HumanoidRootPart", 10)

            if not S.RUNNING
                or not humanoid
                or not root then

                return
            end

            -- Impedir que um respawn antigo substitua o personagem atual.
            if S.LocalPlayer.Character ~= character then
                return
            end

            S.SetupLocal(character)
        end)
    end)
)

--//====================================================
--// ENCERRAMENTO COMPLETO
--//====================================================

S.Shutdown = function()
    if not S.RUNNING then
        return
    end

    S.RUNNING = false

    -- Invalidar tarefas assíncronas anteriores.
    S.LastSurvivorGeneration =
        (S.LastSurvivorGeneration or 0) + 1

    -- Monitoramento principal.
    if S.NPCUpdateConnection then
        S.NPCUpdateConnection:Disconnect()
        S.NPCUpdateConnection = nil
    end

    if S.LastSurvivorMonitorConnection then
        S.LastSurvivorMonitorConnection:Disconnect()
        S.LastSurvivorMonitorConnection = nil
    end

    -- Conexões globais.
    if S.DisconnectAll then
        S.DisconnectAll(S.GlobalConnections)
    end

    -- Música.
    S.StopLastSurvivorMusic()

    -- Jogador.
    if S.CleanupLocal then
        S.CleanupLocal()
    end

    -- NPCs.
    local npcs = {}

    for npc in pairs(S.NPCStates or {}) do
        table.insert(npcs, npc)
    end

    for _, npc in ipairs(npcs) do
        if S.DestroyNPCState then
            pcall(function()
                S.DestroyNPCState(npc)
            end)
        end
    end

    -- Interface.
    if S.ScreenGui then
        S.ScreenGui:Destroy()
        S.ScreenGui = nil
    end

    S.UI = {}

    S.Main = nil
    S.Reopen = nil

    S.ClassicButton = nil
    S.AnimatedButton = nil
    S.ModeLabel = nil
    S.Status = nil

    S.Initialized = false

    print("[R6System] Sistema encerrado.")
end

--//====================================================
--// INICIALIZAÇÃO FINAL
--//====================================================

if S.RefreshModeButtons then
    S.RefreshModeButtons()
end

if S.LocalPlayer.Character then
    S.SetupLocal(S.LocalPlayer.Character)
end

if S.RefreshNPCSystem then
    S.RefreshNPCSystem()
end

S.Initialized = true

print("========================================")
