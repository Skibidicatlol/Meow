end

--==============================================================
-- MAIN MESSAGE PROCESSOR
--==============================================================

function COS:ProcessIncomingMessage(Data)

    if not self.Config.Chat.Enabled then
        return false
    end

    if not self.Config.Chat.ReadMessages then
        return false
    end

    if typeof(Data) ~= "table" then
        return false
    end

    local Message = Data.Text
    local Sender = Data.Sender
    local MessageId = Data.MessageId

    if typeof(Message) ~= "string" then
        return false
    end

    if self.Config.Chat.IgnoreOwnMessages
        and Data.IsLocalPlayer == true then

        return false
    end

    if not self:ProcessChatMessageId(MessageId) then
        return false
    end

    Message = self:Trim(Message)

    if Message == "" then
        return false
    end

    self.State.MessagesReceived += 1

    self:Log(
        "CHAT",
        tostring(Sender or "Jogador") .. ": " .. Message
    )

    --==========================================================
    -- CHECK RELEVANCE
    --==========================================================

    local Mentioned = self:IsMentioned(Message)
    local Question = self:IsQuestion(Message)

    if self.Config.Chat.RespondWhenMentioned
        and not Mentioned
        and not Question then

        return false
    end

    --==========================================================
    -- AUTOMATIC RESPONSE
    --==========================================================

    local Automatic =
        self:GetAutomaticResponse(Message)

    if Automatic then

        if self:IsCoolingDown() then

            self:DeliverChatResponse(
                self:GetCooldownMessage()
            )

            return false
        end

        if self.Config.Cooldown.Enabled then
            self:StartCooldown()
        end

        self:DeliverChatResponse(Automatic)

        return true
    end

    --==========================================================
    -- QUESTION COUNTER
    --==========================================================

    if Question or Mentioned then

        self.State.QuestionsReceived += 1

        self.State.LastQuestion = Message

    end

    --==========================================================
    -- COOLDOWN
    --==========================================================

    if self:IsCoolingDown() then

        self:DeliverChatResponse(
            self:GetCooldownMessage()
        )

        return false
    end

    if self.Config.Cooldown.Enabled
        and self.Config.Cooldown.StartOnQuestionReceived
        and (Question or Mentioned) then

        self:StartCooldown()

    end

    --==========================================================
    -- AI REQUEST
    --==========================================================

    if not Question and not Mentioned then
        return false
    end

    if not self.Config.General.Enabled then
        return false
    end

    task.spawn(function()

        local Response = self:RequestAI(Message)

        if Response then

            self:DeliverChatResponse(Response)

        else

            self:DeliverChatResponse(
                self:AIErrorMessage()
            )

        end

    end)

    return true
end

