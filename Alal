    if S.ModeLabel then
        S.ModeLabel.Text =
            "Modo: " .. tostring(S.CurrentMode)
    end

    if classicButton and classicButton.Parent then

        classicButton.BackgroundColor3 =
            S.CurrentMode == "Classic"
            and Color3.fromRGB(35, 105, 175)
            or Color3.fromRGB(35, 48, 72)
    end

    if animatedButton and animatedButton.Parent then

        animatedButton.BackgroundColor3 =
            S.CurrentMode == "Animated"
            and Color3.fromRGB(35, 105, 175)
            or Color3.fromRGB(35, 48, 72)
    end
end

S.RefreshModeButtons()

--========================================================--
-- MONITORAMENTO AUTOMÁTICO
--========================================================--

S.LastNPCScan = 0
S.LastNPCUpdate = 0
S.LastUIUpdate = 0

S.NPCUpdateConnection =
    S.RunService.Heartbeat:Connect(function()

        if not S.RUNNING then
            return
        end

        local now = os.clock()

        -- Varredura periódica automática.
        if now - S.LastNPCScan >= S.CONFIG.SCAN_INTERVAL then

            S.LastNPCScan = now

            task.spawn(function()

                if S.RUNNING then
                    S.ScanNPCs()
                end
            end)
        end

        -- Atualização contínua dos NPCs.
        if now - S.LastNPCUpdate >= 0.15 then

            S.LastNPCUpdate = now

            S.UpdateNPCs()
        end

        -- Atualização do contador da interface.
        if now - S.LastUIUpdate >= 0.5 then

            S.LastUIUpdate = now

            if statusLabel and statusLabel.Parent then

                local count = 0

                for _, state in pairs(S.NPCStates) do

                    if state.Active then
                        count += 1
                    end
                end

                statusLabel.Text = "NPCs: " .. tostring(count)
            end
        end
    end)

S.Connect(
    S.GlobalConnections,
    S.NPCUpdateConnection
)

print("[R6System] Parte D carregada.")
print("[R6System] NPCs monitorados automaticamente.")

end
