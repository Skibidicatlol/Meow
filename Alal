-- VARREDURA DE NPCs
--========================================================--

S.ScanNPCs = function()
    if not S.RUNNING then
        return
    end

    if not S.CanRunNPCSystem() then
        return
    end

    local map = S.Workspace:FindFirstChild("Map")

    if not map then
        return
    end

    for _, object in ipairs(map:GetDescendants()) do

        if object:IsA("Model")
            and not S.NPCStates[object]
            and not S.IsExcluded(object) then

            if object:FindFirstChildOfClass("Humanoid") then
                task.spawn(function()
                    if S.RUNNING
                        and not S.NPCStates[object] then

                        S.SetupNPC(object)
                    end
                end)
            end
        end
    end
end

--========================================================--
-- ATUALIZAÇÃO DOS NPCs
--========================================================--

S.UpdateNPCs = function()
    if not S.RUNNING then
        return
    end

    for model, state in pairs(S.NPCStates) do

        if not model
            or not model.Parent
            or not state.Rig
            or not state.Rig.Parent then

            S.DestroyNPCState(model)

        elseif state.Active then

            S.EnforceNPCOriginalHidden(state)

            S.UpdatePartSizes(state)
            S.UpdateAccessories(state)

            S.EnforceR6VisualProperties(state.Rig)
        end
    end
end

--========================================================--
-- ATUALIZAÇÃO COMPLETA DO SISTEMA NPC
--========================================================--

S.RefreshNPCSystem = function()
    if not S.RUNNING then
        return
    end

    -- Remove estados inválidos.
    for model, state in pairs(S.NPCStates) do

        if not model or not model.Parent then
            S.DestroyNPCState(model)

        elseif not state.Rig or not state.Rig.Parent then
            S.DestroyNPCState(model)
        end
    end

    S.ScanNPCs()
end

