--========================================================--

do

--========================================================--
-- CONFIGURAÇÕES LAST SURVIVOR
--========================================================--

S.LAST_SURVIVOR = {
    MUSIC_URL = "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3",

    FILE_NAME = "R6System_LastSurvivor.mp3",

    VOLUME = 0.7,

    CHECK_INTERVAL = 1,
}

S.LastSurvivorSound = nil
S.LastSurvivorPlaying = false
S.LastSurvivorMonitorConnection = nil

--========================================================--
-- PASTAS DE TIMES
--========================================================--

S.GetTeamFolders = function()
    local playersFolder =
        S.Workspace:FindFirstChild("Players")

    if not playersFolder then
        return nil, nil
    end

    local killersFolder =
        playersFolder:FindFirstChild("Killers")

    local survivorsFolder =
        playersFolder:FindFirstChild("Survivors")

    return killersFolder, survivorsFolder
end

--========================================================--
-- VERIFICAR SE O JOGADOR LOCAL É KILLER
--========================================================--

S.IsLocalPlayerKiller = function()
    local character = S.LocalPlayer.Character

    if not character then
        return false
    end

    local killersFolder = S.GetTeamFolders()

    if not killersFolder then
        return false
    end

    return character:IsDescendantOf(killersFolder)
end

--========================================================--
-- ENCONTRAR ÚNICO SOBREVIVENTE VIVO
--========================================================--

S.GetSingleAliveSurvivor = function()
    local _, survivorsFolder = S.GetTeamFolders()

    if not survivorsFolder then
        return nil
    end

    local aliveSurvivor = nil
    local aliveCount = 0

    for _, player in ipairs(S.Players:GetPlayers()) do

        local character = player.Character

        if character
            and character.Parent
            and character:IsDescendantOf(survivorsFolder) then

            local humanoid =
                character:FindFirstChildOfClass("Humanoid")

            if humanoid and humanoid.Health > 0 then

                aliveCount += 1
                aliveSurvivor = player

                if aliveCount > 1 then
                    return nil
                end
            end
        end
    end

    if aliveCount == 1 then
        return aliveSurvivor
    end

    return nil
end

--========================================================--
-- VERIFICAR CONDIÇÃO LAST SURVIVOR
--========================================================--

S.ShouldPlayLastSurvivor = function()
    if not S.RUNNING then
        return false
    end

    if not S.IsLocalPlayerKiller() then
        return false
    end

    local survivor = S.GetSingleAliveSurvivor()

    return survivor ~= nil
end

--========================================================--
-- OBTER ASSET DA MÚSICA
--========================================================--

S.GetLastSurvivorAsset = function()
    local fileName = S.LAST_SURVIVOR.FILE_NAME

    if not fileName then
        return nil
    end

    -- Usa o arquivo já salvo, quando disponível.
    if isfile and getcustomasset then

        local success, exists = pcall(function()
            return isfile(fileName)
        end)

        if success and exists then

            local assetSuccess, asset = pcall(function()
                return getcustomasset(fileName)
            end)

            if assetSuccess and asset then
                return asset
            end
        end
    end

    -- Baixa o arquivo quando necessário.
    if writefile and game.HttpGet then

        local success, result = pcall(function()
            return game:HttpGet(
                S.LAST_SURVIVOR.MUSIC_URL
            )
        end)

        if success and result and #result > 0 then

            local writeSuccess = pcall(function()
                writefile(fileName, result)
            end)

            if writeSuccess and getcustomasset then

                local assetSuccess, asset = pcall(function()
                    return getcustomasset(fileName)
                end)

                if assetSuccess and asset then
                    return asset
                end
            end
        end
    end

    -- Fallback para URL.
    return S.LAST_SURVIVOR.MUSIC_URL
end

--========================================================--
-- PARAR MÚSICA
--========================================================--

S.StopLastSurvivorMusic = function()
    S.LastSurvivorPlaying = false

    local sound = S.LastSurvivorSound

    if sound then

        pcall(function()
            sound:Stop()
            sound:Destroy()
        end)
    end

    S.LastSurvivorSound = nil
end

--========================================================--
-- INICIAR MÚSICA
--========================================================--

S.StartLastSurvivorMusic = function()
    if not S.RUNNING then
        return
    end

    if S.LastSurvivorPlaying then
        return
    end

    S.LastSurvivorPlaying = true

    task.spawn(function()

        if not S.RUNNING then
            S.LastSurvivorPlaying = false
            return
        end

        local asset = S.GetLastSurvivorAsset()

        if not S.RUNNING then
            S.LastSurvivorPlaying = false
            return
        end

        if not asset then
            S.LastSurvivorPlaying = false
            return
        end

        local sound = Instance.new("Sound")

        sound.Name = "R6_LastSurvivorMusic"
        sound.SoundId = asset
        sound.Volume = S.LAST_SURVIVOR.VOLUME
        sound.Looped = true

        sound.Parent = S.SoundService

        S.LastSurvivorSound = sound

        local loaded = pcall(function()
            sound:Play()
        end)

        if not loaded then

            S.StopLastSurvivorMusic()
            return
        end

        -- Evita manter música caso a condição tenha mudado
        -- durante o carregamento do asset.
        if not S.RUNNING
            or not S.ShouldPlayLastSurvivor() then

            S.StopLastSurvivorMusic()
        end
    end)
end

--========================================================--
-- MONITORAR LAST SURVIVOR
--========================================================--

S.LastSurvivorMonitorConnection =
    S.RunService.Heartbeat:Connect(function()

        if not S.RUNNING then
            return
        end

        local now = os.clock()

        if not S.LastSurvivorNextCheck then
            S.LastSurvivorNextCheck = 0
        end

        if now < S.LastSurvivorNextCheck then
            return
        end

        S.LastSurvivorNextCheck =
            now + S.LAST_SURVIVOR.CHECK_INTERVAL

        if S.ShouldPlayLastSurvivor() then

            if not S.LastSurvivorPlaying then
                S.StartLastSurvivorMusic()
            end

        else

            if S.LastSurvivorPlaying
                or S.LastSurvivorSound then

                S.StopLastSurvivorMusic()
            end
        end
    end)

S.Connect(
    S.GlobalConnections,
    S.LastSurvivorMonitorConnection
)

--========================================================--
-- RESPAWN DO PERSONAGEM
--========================================================--

S.CharacterAddedConnection =
    S.LocalPlayer.CharacterAdded:Connect(function(character)

        if not S.RUNNING then
            return
        end

        task.spawn(function()

            local humanoid =
                character:WaitForChild("Humanoid", 15)

            local root =
                character:WaitForChild(
                    "HumanoidRootPart",
                    15
                )

            if not S.RUNNING then
                return
            end

            if not humanoid or not root then
                return
            end

            if S.LocalPlayer.Character ~= character then
                return
            end

            S.SetupLocal(character)

            if S.RefreshModeButtons then
                S.RefreshModeButtons()
            end
        end)
    end)

S.Connect(
    S.GlobalConnections,
    S.CharacterAddedConnection
)

--========================================================--
-- ENCERRAMENTO COMPLETO
--========================================================--

S.Shutdown = function()
    if not S.RUNNING then
        return
    end

    S.RUNNING = false

    S.Generation = (S.Generation or 0) + 1

    -- Para monitoramento NPC.
    if S.NPCUpdateConnection then

        pcall(function()
            S.NPCUpdateConnection:Disconnect()
        end)

        S.NPCUpdateConnection = nil
    end

    -- Para monitoramento Last Survivor.
    if S.LastSurvivorMonitorConnection then

        pcall(function()
            S.LastSurvivorMonitorConnection:Disconnect()
        end)

        S.LastSurvivorMonitorConnection = nil
    end

    -- Desconecta todas as conexões globais.
    S.DisconnectAll(S.GlobalConnections)

    -- Para música.
    S.StopLastSurvivorMusic()

    -- Limpa personagem local.
    S.CleanupLocal()

    -- Limpa todos os NPCs.
    local models = {}

    for model in pairs(S.NPCStates) do
        table.insert(models, model)
    end

    for _, model in ipairs(models) do
        S.DestroyNPCState(model)
    end

    -- Remove interface.
    if S.UI then

        pcall(function()
            S.UI:Destroy()
        end)
    end

    S.UI = nil
    S.Main = nil
    S.Reopen = nil
    S.ModeLabel = nil

    S.Initialized = false

    print("[R6System] Sistema encerrado.")
end

--========================================================--
-- INICIALIZAÇÃO FINAL
--========================================================--

if not S.RUNNING then
    return
end

-- Atualiza os botões da interface.
if S.RefreshModeButtons then
    S.RefreshModeButtons()
end

-- Configura personagem atual.
local currentCharacter = S.LocalPlayer.Character

if currentCharacter then

    task.spawn(function()

        local humanoid =
            currentCharacter:WaitForChild("Humanoid", 15)

        local root =
            currentCharacter:WaitForChild(
                "HumanoidRootPart",
                15
            )

        if S.RUNNING
            and humanoid
            and root
            and S.LocalPlayer.Character == currentCharacter then

            S.SetupLocal(currentCharacter)
        end
    end)
end

-- Primeira varredura automática.
task.spawn(function()

    if S.RUNNING then
        S.RefreshNPCSystem()
    end
end)

-- Marca inicialização.
S.Initialized = true

print("======================================")
print("[R6System] SISTEMA INICIALIZADO")
print("[R6System] Modo:", S.CurrentMode)
print("[R6System] NPCs: monitoramento automático")
print("[R6System] Interface: carregada")
print("[R6System] Last Survivor: monitoramento ativo")
print("======================================")

end
