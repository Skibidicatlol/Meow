--//====================================================
--// MONITORAMENTO AUTOMÁTICO DE NPCs
--//====================================================

S.LastNPCScan = 0
S.NPCScanInterval = 3
S.NPCUpdateInterval = 0.15
S.LastNPCUpdate = 0

if S.NPCUpdateConnection then
    S.NPCUpdateConnection:Disconnect()
    S.NPCUpdateConnection = nil
end

S.NPCUpdateConnection = S.RunService.Heartbeat:Connect(function()
    if not S.RUNNING then
        return
    end

    local now = os.clock()

    -- Buscar NPCs novos automaticamente
    if now - S.LastNPCScan >= S.NPCScanInterval then
        S.LastNPCScan = now

        if S.ScanNPCs then
            local success, err = pcall(function()
                S.ScanNPCs()
            end)

            if not success then
                warn("[R6System] Erro ao procurar NPCs:", err)
            end
        end
    end

    -- Atualizar NPCs transformados
    if now - S.LastNPCUpdate >= S.NPCUpdateInterval then
        S.LastNPCUpdate = now

        if S.UpdateNPCs then
            local success, err = pcall(function()
                S.UpdateNPCs()
            end)

            if not success then
                warn("[R6System] Erro ao atualizar NPCs:", err)
            end
        end
    end

    -- Atualizar contador
    if S.Status and S.NPCStates then
        local count = 0

        for _ in pairs(S.NPCStates) do
            count += 1
        end

        S.Status.Text = "NPCs: " .. tostring(count)
    end
end)

