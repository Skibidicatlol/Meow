-- COOLDOWN SETTINGS
--==============================================================

function COS:SetCooldown(Duration)

    Duration = tonumber(Duration)

    if not Duration then
        return false
    end

    Duration = math.clamp(
        math.floor(Duration),
        1,
        120
    )

    self.Config.Cooldown.Duration = Duration

    self:Log(
        "COOLDOWN",
        "Duração alterada para " .. Duration .. " segundos."
    )

    return true
end

